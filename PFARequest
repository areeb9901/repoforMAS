CREATE OR REPLACE PROCEDURE SORT_AMENDMENTS_GROUP
(
    grpId NUMBER,
    Cuser VARCHAR2
)
AS
    ---------------------------------------------------------------------------
    -- Amendment row-to-final-ID mapping
    ---------------------------------------------------------------------------
    TYPE Rec_Amd_Map IS RECORD
    (
        Rowid_Amd  UROWID,
        Old_Amd_Id NUMBER,
        New_Amd_Id NUMBER
    );

    TYPE Typ_Amd_Map IS TABLE OF Rec_Amd_Map
        INDEX BY PLS_INTEGER;

    V_Amd_Map Typ_Amd_Map;

    v_map_index              PLS_INTEGER;
    v_ref_index              PLS_INTEGER := 0;
    v_temp_base              NUMBER;
    v_group_slot_count       NUMBER := 0;
    v_validation_temp_base   NUMBER;
    v_validation_index       PLS_INTEGER;
    v_duplicate_count        NUMBER;
    v_dummy                   NUMBER;

BEGIN
    SAVEPOINT before_sort_amendments_group;

    ---------------------------------------------------------------------------
    -- IMPORTANT:
    -- These reference tables should preferably be GLOBAL TEMPORARY TABLES.
    -- If they are normal permanent tables, simultaneous executions can
    -- interfere with one another.
    ---------------------------------------------------------------------------
    DELETE FROM AMD_REF_TABLE;
    DELETE FROM EXEC_DOC_REF_TABLE;
    DELETE FROM AMD_VALDN_REF_TABLE;
    DELETE FROM EXEC_DOC_GRP_REF_TABLE;

    ---------------------------------------------------------------------------
    -- Serialize processing for the same group.
    --
    -- Locking the MA rows ensures that two sessions do not sort the same
    -- group simultaneously, provided every caller uses this procedure.
    ---------------------------------------------------------------------------
    FOR LockRow IN
    (
        SELECT ma_id
        FROM LDM_TB_MA
        WHERE grp_id = grpId
        ORDER BY ma_id
        FOR UPDATE
    )
    LOOP
        NULL;
    END LOOP;

    ---------------------------------------------------------------------------
    -- Build the authoritative group amendment sequence.
    --
    -- A date may occur multiple times for the same MA. Therefore, we calculate
    -- an occurrence number for every date in every MA and determine the
    -- maximum occurrence required for the group.
    --
    -- Example:
    --
    -- MA A: 01-JAN, 01-JAN, 02-FEB
    -- MA B: 01-JAN,         02-FEB
    --
    -- Group slots:
    -- 1 = 01-JAN occurrence 1
    -- 2 = 01-JAN occurrence 2
    -- 3 = 02-FEB occurrence 1
    ---------------------------------------------------------------------------
    v_ref_index := 0;

    FOR GroupDate IN
    (
        SELECT exec_date,
               MAX(date_occurrence) AS max_occurrence
        FROM
        (
            SELECT amd.ma_id,
                   amd.amd_d_sign AS exec_date,
                   ROW_NUMBER() OVER
                   (
                       PARTITION BY amd.ma_id,
                                    amd.amd_d_sign
                       ORDER BY amd.date_creat,
                                amd.ROWID
                   ) AS date_occurrence
            FROM LDM_TB_AMD amd
            JOIN LDM_TB_MA ma
              ON ma.ma_id = amd.ma_id
            WHERE ma.grp_id = grpId
              AND ma.in_nego_flg = 'N'

              -- STATUS_ID = 8 is assumed to mean terminated MA.
              AND NVL(ma.status_id, -1) <> 8

              AND amd.amd_id > 0
              AND amd.amd_d_sign IS NOT NULL
              AND amd.amd_d_term IS NULL
        )
        GROUP BY exec_date
        ORDER BY exec_date
    )
    LOOP
        FOR occurrence_no IN 1 .. GroupDate.max_occurrence
        LOOP
            v_ref_index := v_ref_index + 1;

            INSERT INTO AMD_REF_TABLE
            (
                IDX_NO,
                EXEC_DATE
            )
            VALUES
            (
                v_ref_index,
                GroupDate.exec_date
            );
        END LOOP;
    END LOOP;

    v_group_slot_count := v_ref_index;

    ---------------------------------------------------------------------------
    -- Save group-level executed-document references before changing AMD_ID.
    --
    -- Existing duplicate AMD_ID values can cause more than one amendment row
    -- to match the same group document. In that situation, prefer:
    --
    -- 1. Active, signed amendment
    -- 2. Oldest creation date
    -- 3. ROWID as deterministic tie-breaker
    ---------------------------------------------------------------------------
    INSERT INTO EXEC_DOC_GRP_REF_TABLE
    (
        ROW_ID,
        EXEC_DATE,
        ROWID_AMD
    )
    SELECT row_id,
           exec_date,
           rowid_amd
    FROM
    (
        SELECT negoGrp.row_id AS row_id,
               amd.amd_d_sign AS exec_date,
               amd.ROWID AS rowid_amd,
               ROW_NUMBER() OVER
               (
                   PARTITION BY negoGrp.row_id
                   ORDER BY
                       CASE
                           WHEN amd.amd_d_sign IS NOT NULL
                            AND amd.amd_d_term IS NULL
                           THEN 0
                           ELSE 1
                       END,
                       amd.date_creat,
                       amd.ROWID
               ) AS rn
        FROM NEGO_TB_ROW_EXEC_DOC_FOR_GRP negoGrp
        JOIN LDM_TB_MA ma
          ON ma.grp_id = negoGrp.grp_id
        JOIN LDM_TB_AMD amd
          ON amd.ma_id = ma.ma_id
         AND amd.amd_id = negoGrp.amd_id
        WHERE negoGrp.grp_id = grpId
          AND ma.in_nego_flg = 'N'
          AND NVL(ma.status_id, -1) <> 8
          AND amd.amd_id > 0
    )
    WHERE rn = 1;

    ---------------------------------------------------------------------------
    -- Process every eligible MA in the group
    ---------------------------------------------------------------------------
    FOR Eachma IN
    (
        SELECT ma_id
        FROM LDM_TB_MA
        WHERE grp_id = grpId
          AND in_nego_flg = 'N'
          AND NVL(status_id, -1) <> 8
        ORDER BY ma_id
    )
    LOOP
        DELETE FROM EXEC_DOC_REF_TABLE;
        DELETE FROM AMD_VALDN_REF_TABLE;

        -----------------------------------------------------------------------
        -- Save individual executed-document references.
        --
        -- If duplicate AMD_ID values already exist, prefer the active signed
        -- amendment because the old AMD_ID alone is ambiguous.
        -----------------------------------------------------------------------
        INSERT INTO EXEC_DOC_REF_TABLE
        (
            ROW_ID,
            EXEC_DATE,
            ROWID_AMD
        )
        SELECT row_id,
               exec_date,
               rowid_amd
        FROM
        (
            SELECT nego.row_id,
                   amd.amd_d_sign AS exec_date,
                   amd.ROWID AS rowid_amd,
                   ROW_NUMBER() OVER
                   (
                       PARTITION BY nego.row_id
                       ORDER BY
                           CASE
                               WHEN amd.amd_d_sign IS NOT NULL
                                AND amd.amd_d_term IS NULL
                               THEN 0
                               ELSE 1
                           END,
                           amd.date_creat,
                           amd.ROWID
                   ) AS rn
            FROM NEGO_TB_ROW_EXEC_DOC nego
            JOIN LDM_TB_AMD amd
              ON amd.ma_id = nego.ma_id
             AND amd.amd_id = nego.amd_id
            WHERE nego.ma_id = Eachma.ma_id
              AND amd.amd_id > 0
        )
        WHERE rn = 1;

        -----------------------------------------------------------------------
        -- Save validation references.
        --
        -- Existing duplicate AMD_ID values are handled using the same
        -- preference for active signed amendment rows.
        -----------------------------------------------------------------------
        INSERT INTO AMD_VALDN_REF_TABLE
        (
            AMD_ID,
            ROWID_VALDN,
            ROWID_AMD
        )
        SELECT old_amd_id,
               rowid_valdn,
               rowid_amd
        FROM
        (
            SELECT valdn.amendment_id AS old_amd_id,
                   valdn.ROWID AS rowid_valdn,
                   amd.ROWID AS rowid_amd,
                   ROW_NUMBER() OVER
                   (
                       PARTITION BY valdn.ROWID
                       ORDER BY
                           CASE
                               WHEN amd.amd_d_sign IS NOT NULL
                                AND amd.amd_d_term IS NULL
                               THEN 0
                               ELSE 1
                           END,
                           amd.date_creat,
                           amd.ROWID
                   ) AS rn
            FROM AMENDMENT_VALIDATIONS valdn
            JOIN LDM_TB_AMD amd
              ON amd.ma_id = valdn.agreement_id
             AND amd.amd_id = valdn.amendment_id
            WHERE valdn.agreement_id = Eachma.ma_id
              AND amd.amd_id > 0
              AND valdn.validator IS NOT NULL
        )
        WHERE rn = 1;

        -----------------------------------------------------------------------
        -- Build final mapping for every positive amendment row.
        --
        -- Active amendments:
        -- Assigned the authoritative group-level ID based on:
        --     execution date + occurrence number
        --
        -- Excluded amendments:
        -- Terminated or null-sign-date rows are placed after the active group
        -- sequence, ensuring they cannot collide with active amendment IDs.
        -----------------------------------------------------------------------
        V_Amd_Map.DELETE;
        v_map_index := 0;

        FOR Maprow IN
        (
            WITH Active_Rows AS
            (
                SELECT amd.ROWID AS rowid_amd,
                       amd.amd_id AS old_amd_id,
                       amd.amd_d_sign AS exec_date,
                       ROW_NUMBER() OVER
                       (
                           PARTITION BY amd.amd_d_sign
                           ORDER BY amd.date_creat,
                                    amd.ROWID
                       ) AS date_occurrence
                FROM LDM_TB_AMD amd
                WHERE amd.ma_id = Eachma.ma_id
                  AND amd.amd_id > 0
                  AND amd.amd_d_sign IS NOT NULL
                  AND amd.amd_d_term IS NULL
            ),
            Group_Reference AS
            (
                SELECT ref.idx_no,
                       ref.exec_date,
                       ROW_NUMBER() OVER
                       (
                           PARTITION BY ref.exec_date
                           ORDER BY ref.idx_no
                       ) AS date_occurrence
                FROM AMD_REF_TABLE ref
            ),
            Excluded_Rows AS
            (
                SELECT amd.ROWID AS rowid_amd,
                       amd.amd_id AS old_amd_id,
                       ROW_NUMBER() OVER
                       (
                           ORDER BY
                               CASE
                                   WHEN amd.amd_d_term IS NOT NULL THEN 1
                                   ELSE 2
                               END,
                               NVL(amd.amd_d_sign, DATE '9999-12-31'),
                               amd.date_creat,
                               amd.ROWID
                       ) AS excluded_sequence
                FROM LDM_TB_AMD amd
                WHERE amd.ma_id = Eachma.ma_id
                  AND amd.amd_id > 0
                  AND
                  (
                      amd.amd_d_sign IS NULL
                      OR amd.amd_d_term IS NOT NULL
                  )
            )
            SELECT rowid_amd,
                   old_amd_id,
                   new_amd_id
            FROM
            (
                SELECT active.rowid_amd,
                       active.old_amd_id,
                       ref.idx_no AS new_amd_id,
                       1 AS row_category
                FROM Active_Rows active
                JOIN Group_Reference ref
                  ON ref.exec_date = active.exec_date
                 AND ref.date_occurrence =
                     active.date_occurrence

                UNION ALL

                SELECT excluded.rowid_amd,
                       excluded.old_amd_id,
                       v_group_slot_count
                           + excluded.excluded_sequence AS new_amd_id,
                       2 AS row_category
                FROM Excluded_Rows excluded
            )
            ORDER BY row_category,
                     new_amd_id,
                     rowid_amd
        )
        LOOP
            v_map_index := v_map_index + 1;

            V_Amd_Map(v_map_index).Rowid_Amd :=
                Maprow.rowid_amd;

            V_Amd_Map(v_map_index).Old_Amd_Id :=
                Maprow.old_amd_id;

            V_Amd_Map(v_map_index).New_Amd_Id :=
                Maprow.new_amd_id;
        END LOOP;

        -----------------------------------------------------------------------
        -- Verify that every positive amendment row has been mapped.
        -----------------------------------------------------------------------
        SELECT COUNT(*)
        INTO v_dummy
        FROM LDM_TB_AMD
        WHERE ma_id = Eachma.ma_id
          AND amd_id > 0;

        IF v_dummy <> V_Amd_Map.COUNT THEN
            RAISE_APPLICATION_ERROR
            (
                -20010,
                'Not all amendment rows were mapped for MA '
                || Eachma.ma_id
                || '. Expected '
                || v_dummy
                || ', mapped '
                || V_Amd_Map.COUNT
            );
        END IF;

        -----------------------------------------------------------------------
        -- Two-phase AMD_ID update.
        --
        -- All positive rows are moved, including terminated and null-date rows.
        -- This ensures no existing row remains on an ID needed by another row.
        -----------------------------------------------------------------------
        IF V_Amd_Map.COUNT > 0 THEN
            SELECT NVL(MAX(ABS(amd_id)), 0)
                   + V_Amd_Map.COUNT
                   + 1000
            INTO v_temp_base
            FROM LDM_TB_AMD
            WHERE ma_id = Eachma.ma_id;

            -------------------------------------------------------------------
            -- Phase 1: temporary IDs
            -------------------------------------------------------------------
            FOR i IN V_Amd_Map.FIRST .. V_Amd_Map.LAST
            LOOP
                UPDATE LDM_TB_AMD
                SET amd_id     = v_temp_base + i,
                    date_modif = SYSDATE,
                    user_modif = Cuser
                WHERE ROWID = V_Amd_Map(i).Rowid_Amd;

                IF SQL%ROWCOUNT <> 1 THEN
                    RAISE_APPLICATION_ERROR
                    (
                        -20011,
                        'Temporary AMD_ID update failed for MA '
                        || Eachma.ma_id
                    );
                END IF;
            END LOOP;

            -------------------------------------------------------------------
            -- Phase 2: final IDs
            -------------------------------------------------------------------
            FOR i IN V_Amd_Map.FIRST .. V_Amd_Map.LAST
            LOOP
                UPDATE LDM_TB_AMD
                SET amd_id     = V_Amd_Map(i).New_Amd_Id,
                    date_modif = SYSDATE,
                    user_modif = Cuser
                WHERE ROWID = V_Amd_Map(i).Rowid_Amd;

                IF SQL%ROWCOUNT <> 1 THEN
                    RAISE_APPLICATION_ERROR
                    (
                        -20012,
                        'Final AMD_ID update failed for MA '
                        || Eachma.ma_id
                    );
                END IF;
            END LOOP;
        END IF;

        -----------------------------------------------------------------------
        -- Update individual executed-document references using amendment ROWID
        -----------------------------------------------------------------------
        MERGE INTO NEGO_TB_ROW_EXEC_DOC exec_doc
        USING
        (
            SELECT reft.row_id AS ref_row_id,
                   amd.amd_id AS new_amd_id
            FROM EXEC_DOC_REF_TABLE reft
            JOIN LDM_TB_AMD amd
              ON amd.ROWID = reft.rowid_amd
            WHERE amd.ma_id = Eachma.ma_id
        ) data_t
        ON
        (
            exec_doc.row_id = data_t.ref_row_id
            AND exec_doc.ma_id = Eachma.ma_id
        )
        WHEN MATCHED THEN
            UPDATE SET
                exec_doc.amd_id     = data_t.new_amd_id,
                exec_doc.user_modif = Cuser,
                exec_doc.date_modif = SYSDATE;

        -----------------------------------------------------------------------
        -- Two-phase validation reference update
        -----------------------------------------------------------------------
        SELECT NVL(MAX(ABS(amendment_id)), 0)
               + COUNT(*)
               + 1000
        INTO v_validation_temp_base
        FROM AMENDMENT_VALIDATIONS
        WHERE agreement_id = Eachma.ma_id;

        v_validation_index := 0;

        FOR ValidationRef IN
        (
            SELECT rowid_valdn,
                   rowid_amd
            FROM AMD_VALDN_REF_TABLE
            ORDER BY rowid_valdn
        )
        LOOP
            v_validation_index := v_validation_index + 1;

            UPDATE AMENDMENT_VALIDATIONS
            SET amendment_id =
                    v_validation_temp_base + v_validation_index
            WHERE ROWID = ValidationRef.rowid_valdn;
        END LOOP;

        FOR ValidationRef IN
        (
            SELECT ref.rowid_valdn,
                   amd.amd_id AS final_amd_id
            FROM AMD_VALDN_REF_TABLE ref
            JOIN LDM_TB_AMD amd
              ON amd.ROWID = ref.rowid_amd
            ORDER BY ref.rowid_valdn
        )
        LOOP
            UPDATE AMENDMENT_VALIDATIONS
            SET amendment_id = ValidationRef.final_amd_id
            WHERE ROWID = ValidationRef.rowid_valdn;
        END LOOP;

        -----------------------------------------------------------------------
        -- Validate uniqueness for the current MA immediately
        -----------------------------------------------------------------------
        SELECT COUNT(*)
        INTO v_duplicate_count
        FROM
        (
            SELECT amd_id
            FROM LDM_TB_AMD
            WHERE ma_id = Eachma.ma_id
              AND amd_id > 0
            GROUP BY amd_id
            HAVING COUNT(*) > 1
        );

        IF v_duplicate_count > 0 THEN
            RAISE_APPLICATION_ERROR
            (
                -20013,
                'Duplicate AMD_ID generated for MA '
                || Eachma.ma_id
            );
        END IF;

        DELETE FROM EXEC_DOC_REF_TABLE;
        DELETE FROM AMD_VALDN_REF_TABLE;

        V_Amd_Map.DELETE;
    END LOOP;

    ---------------------------------------------------------------------------
    -- Update group executed-document references
    ---------------------------------------------------------------------------
    MERGE INTO NEGO_TB_ROW_EXEC_DOC_FOR_GRP exec_doc_grp
    USING
    (
        SELECT ref_row_id,
               new_amd_id
        FROM
        (
            SELECT reft.row_id AS ref_row_id,
                   amd.amd_id AS new_amd_id,
                   ROW_NUMBER() OVER
                   (
                       PARTITION BY reft.row_id
                       ORDER BY
                           CASE
                               WHEN amd.amd_d_sign IS NOT NULL
                                AND amd.amd_d_term IS NULL
                               THEN 0
                               ELSE 1
                           END,
                           amd.amd_id,
                           amd.ROWID
                   ) AS rn
            FROM EXEC_DOC_GRP_REF_TABLE reft
            JOIN LDM_TB_AMD amd
              ON amd.ROWID = reft.rowid_amd
        )
        WHERE rn = 1
    ) data_t
    ON
    (
        exec_doc_grp.row_id = data_t.ref_row_id
        AND exec_doc_grp.grp_id = grpId
    )
    WHEN MATCHED THEN
        UPDATE SET
            exec_doc_grp.amd_id     = data_t.new_amd_id,
            exec_doc_grp.user_modif = Cuser,
            exec_doc_grp.date_modif = SYSDATE;

    ---------------------------------------------------------------------------
    -- Final group-level duplicate validation
    ---------------------------------------------------------------------------
    SELECT COUNT(*)
    INTO v_duplicate_count
    FROM
    (
        SELECT amd.ma_id,
               amd.amd_id
        FROM LDM_TB_AMD amd
        JOIN LDM_TB_MA ma
          ON ma.ma_id = amd.ma_id
        WHERE ma.grp_id = grpId
          AND ma.in_nego_flg = 'N'
          AND NVL(ma.status_id, -1) <> 8
          AND amd.amd_id > 0
        GROUP BY amd.ma_id,
                 amd.amd_id
        HAVING COUNT(*) > 1
    );

    IF v_duplicate_count > 0 THEN
        RAISE_APPLICATION_ERROR
        (
            -20014,
            'Duplicate amendment IDs remain for group '
            || grpId
        );
    END IF;

    ---------------------------------------------------------------------------
    -- Ensure every active amendment matches its group reference ID
    ---------------------------------------------------------------------------
    SELECT COUNT(*)
    INTO v_duplicate_count
    FROM
    (
        SELECT amd.ma_id,
               amd.amd_id,
               amd.amd_d_sign,
               ROW_NUMBER() OVER
               (
                   PARTITION BY amd.ma_id,
                                amd.amd_d_sign
                   ORDER BY amd.date_creat,
                            amd.ROWID
               ) AS ma_occurrence,
               ROW_NUMBER() OVER
               (
                   PARTITION BY ref.exec_date
                   ORDER BY ref.idx_no
               ) AS ref_occurrence,
               ref.idx_no
        FROM LDM_TB_AMD amd
        JOIN LDM_TB_MA ma
          ON ma.ma_id = amd.ma_id
        JOIN AMD_REF_TABLE ref
          ON ref.exec_date = amd.amd_d_sign
        WHERE ma.grp_id = grpId
          AND ma.in_nego_flg = 'N'
          AND NVL(ma.status_id, -1) <> 8
          AND amd.amd_id > 0
          AND amd.amd_d_sign IS NOT NULL
          AND amd.amd_d_term IS NULL
    )
    WHERE ma_occurrence = ref_occurrence
      AND amd_id <> idx_no;

    IF v_duplicate_count > 0 THEN
        RAISE_APPLICATION_ERROR
        (
            -20015,
            'Group amendment sequence validation failed for group '
            || grpId
        );
    END IF;

    ---------------------------------------------------------------------------
    -- Cleanup
    ---------------------------------------------------------------------------
    DELETE FROM AMD_REF_TABLE;
    DELETE FROM EXEC_DOC_REF_TABLE;
    DELETE FROM AMD_VALDN_REF_TABLE;
    DELETE FROM EXEC_DOC_GRP_REF_TABLE;

    COMMIT;

EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK TO before_sort_amendments_group;

        BEGIN
            DELETE FROM AMD_REF_TABLE;
            DELETE FROM EXEC_DOC_REF_TABLE;
            DELETE FROM AMD_VALDN_REF_TABLE;
            DELETE FROM EXEC_DOC_GRP_REF_TABLE;
        EXCEPTION
            WHEN OTHERS THEN
                NULL;
        END;

        RAISE;
END SORT_AMENDMENTS_GROUP;
/