SELECT amd.ma_id,
       amd.amd_id,
       COUNT(*) AS duplicate_count
FROM LDM_TB_AMD amd
JOIN LDM_TB_MA ma
  ON ma.ma_id = amd.ma_id
WHERE ma.grp_id = 1177
  AND amd.amd_id > 0
GROUP BY amd.ma_id,
         amd.amd_id
HAVING COUNT(*) > 1
ORDER BY amd.ma_id,
         amd.amd_id;





WITH Sorted_Amendments AS
(
    SELECT amd.ma_id,
           amd.amd_id,
           amd.amd_d_sign,

           ROW_NUMBER() OVER
           (
               PARTITION BY amd.ma_id,
                            amd.amd_d_sign
               ORDER BY amd.date_creat,
                        amd.ROWID
           ) AS date_occurrence
    FROM LDM_TB_AMD amd
    JOIN LDM_TB_MA ma
      ON ma.ma_id = amd.ma_id
    WHERE ma.grp_id = 1177
      AND ma.in_nego_flg = 'N'
      AND NVL(ma.status_id, -1) <> 8
      AND amd.amd_id > 0
      AND amd.amd_d_sign IS NOT NULL
)
SELECT amd_d_sign,
       date_occurrence,
       COUNT(DISTINCT amd_id) AS distinct_amd_ids,
       MIN(amd_id) AS minimum_amd_id,
       MAX(amd_id) AS maximum_amd_id
FROM Sorted_Amendments
GROUP BY amd_d_sign,
         date_occurrence
HAVING COUNT(DISTINCT amd_id) > 1
ORDER BY amd_d_sign,
         date_occurrence;







SELECT amd.ma_id,
       COUNT(*) AS physical_rows,
       MIN(amd.amd_id) AS minimum_amd_id,
       MAX(amd.amd_id) AS maximum_amd_id
FROM LDM_TB_AMD amd
JOIN LDM_TB_MA ma
  ON ma.ma_id = amd.ma_id
WHERE ma.grp_id = 1177
  AND ma.in_nego_flg = 'N'
  AND NVL(ma.status_id, -1) <> 8
  AND amd.amd_id > 0
GROUP BY amd.ma_id
ORDER BY amd.ma_id;