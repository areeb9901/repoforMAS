
SELECT COUNT(*) AS amendment_row_count
FROM LDM_TB_AMD amd
JOIN LDM_TB_MA ma
  ON ma.ma_id = amd.ma_id
WHERE ma.grp_id = 1177
  AND amd.amd_id > 0;


WITH Eligible_Amendments AS
(
    SELECT amd.ma_id,
           amd.amd_d_sign,
           ROW_NUMBER() OVER
           (
               PARTITION BY amd.ma_id,
                            amd.amd_d_sign
               ORDER BY amd.date_creat,
                        amd.ROWID
           ) AS date_occurrence
    FROM LDM_TB_AMD amd
    JOIN LDM_TB_MA ma
      ON ma.ma_id = amd.ma_id
    WHERE ma.grp_id = 1177
      AND ma.in_nego_flg = 'N'
      AND NVL(ma.status_id, -1) <> 8
      AND amd.amd_id > 0
      AND amd.amd_d_sign IS NOT NULL
),
Date_Requirements AS
(
    SELECT amd_d_sign,
           MAX(date_occurrence) AS required_occurrences
    FROM Eligible_Amendments
    GROUP BY amd_d_sign
)
SELECT SUM(required_occurrences) AS signed_group_slot_count
FROM Date_Requirements;







SELECT amd.ma_id,
       COUNT(*) AS amendment_rows,
       COUNT(
           CASE
               WHEN amd.amd_d_sign IS NOT NULL THEN 1
           END
       ) AS signed_rows,
       COUNT(
           CASE
               WHEN amd.amd_d_sign IS NULL THEN 1
           END
       ) AS unsigned_rows
FROM LDM_TB_AMD amd
JOIN LDM_TB_MA ma
  ON ma.ma_id = amd.ma_id
WHERE ma.grp_id = 1177
  AND ma.in_nego_flg = 'N'
  AND NVL(ma.status_id, -1) <> 8
  AND amd.amd_id > 0
GROUP BY amd.ma_id
ORDER BY amd.ma_id;




WITH Eligible_Amendments AS
(
    SELECT amd.ma_id,
           amd.amd_d_sign,

           ROW_NUMBER() OVER
           (
               PARTITION BY amd.ma_id,
                            amd.amd_d_sign
               ORDER BY amd.date_creat,
                        amd.ROWID
           ) AS date_occurrence
    FROM LDM_TB_AMD amd
    JOIN LDM_TB_MA ma
      ON ma.ma_id = amd.ma_id
    WHERE ma.grp_id = 1177
      AND ma.in_nego_flg = 'N'
      AND NVL(ma.status_id, -1) <> 8
      AND amd.amd_id > 0
      AND amd.amd_d_sign IS NOT NULL
),
Date_Requirements AS
(
    SELECT amd_d_sign,
           MAX(date_occurrence) AS required_occurrences
    FROM Eligible_Amendments
    GROUP BY amd_d_sign
),
Numbers AS
(
    SELECT LEVEL AS occurrence_no
    FROM dual
    CONNECT BY LEVEL <=
    (
        SELECT NVL(
                   MAX(required_occurrences),
                   0
               )
        FROM Date_Requirements
    )
),
Group_Reference AS
(
    SELECT ROW_NUMBER() OVER
           (
               ORDER BY dates.amd_d_sign,
                        numbers.occurrence_no
           ) AS expected_amd_id,

           dates.amd_d_sign,
           numbers.occurrence_no
    FROM Date_Requirements dates
    JOIN Numbers numbers
      ON numbers.occurrence_no <=
         dates.required_occurrences
),
Selected_Ma AS
(
    SELECT amd.amd_id AS current_amd_id,
           amd.amd_d_sign,
           amd.date_creat,
           amd.ROWID AS rowid_amd,

           ROW_NUMBER() OVER
           (
               PARTITION BY amd.amd_d_sign
               ORDER BY amd.date_creat,
                        amd.ROWID
           ) AS date_occurrence
    FROM LDM_TB_AMD amd
    WHERE amd.ma_id = 204746
      AND amd.amd_id > 0
      AND amd.amd_d_sign IS NOT NULL
)
SELECT ma.current_amd_id,
       ref.expected_amd_id,
       TO_CHAR(
           ma.amd_d_sign,
           'DD-MON-YYYY HH24:MI:SS'
       ) AS signing_date,
       ma.date_occurrence
FROM Selected_Ma ma
JOIN Group_Reference ref
  ON ref.amd_d_sign = ma.amd_d_sign
 AND ref.occurrence_no = ma.date_occurrence
ORDER BY ref.expected_amd_id;





