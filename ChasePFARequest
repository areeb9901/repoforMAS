CREATE OR REPLACE PROCEDURE SORT_AMENDMENTS_GROUP
(
    grpId NUMBER,
    Cuser VARCHAR2
)
AS
    To_Amd_Id NUMBER;

    ---------------------------------------------------------------------------
    -- Collections used for bulk amendment-ID updates
    ---------------------------------------------------------------------------
    TYPE Typ_Rowid_Table IS TABLE OF UROWID
        INDEX BY PLS_INTEGER;

    TYPE Typ_Number_Table IS TABLE OF NUMBER
        INDEX BY PLS_INTEGER;

    V_Amd_Rowids   Typ_Rowid_Table;
    V_Old_Amd_Ids  Typ_Number_Table;
    V_New_Amd_Ids  Typ_Number_Table;
    V_Temp_Amd_Ids Typ_Number_Table;

    ---------------------------------------------------------------------------
    -- Temporary amendment-ID base
    ---------------------------------------------------------------------------
    v_temp_base NUMBER;

BEGIN
    SAVEPOINT before_sort_amendments_group;

    ---------------------------------------------------------------------------
    -- Clear possible stale reference data from the current transaction
    ---------------------------------------------------------------------------
    DELETE FROM AMD_REF_TABLE;
    DELETE FROM EXEC_DOC_REF_TABLE;
    DELETE FROM AMD_VALDN_REF_TABLE;
    DELETE FROM EXEC_DOC_GRP_REF_TABLE;

    ---------------------------------------------------------------------------
    -- Build the complete ordered amendment-date reference for the group.
    --
    -- This replaces the PL/SQL cursor loop and FORALL insert with one
    -- set-based INSERT.
    --
    -- OCCURRENCE_NO preserves multiple amendments having the same execution
    -- date within an MA.
    ---------------------------------------------------------------------------
    INSERT INTO AMD_REF_TABLE
    (
        IDX_NO,
        EXEC_DATE
    )
    SELECT ROW_NUMBER() OVER
           (
               ORDER BY amd_d_sign,
                        occurrence_no
           ) AS idx_no,
           amd_d_sign
    FROM
    (
        SELECT amd_d_sign,
               occurrence_no
        FROM
        (
            SELECT amd.ma_id,
                   amd.amd_d_sign,

                   ROW_NUMBER() OVER
                   (
                       PARTITION BY amd.ma_id,
                                    amd.amd_d_sign
                       ORDER BY amd.date_creat,
                                amd.ROWID
                   ) AS occurrence_no

            FROM LDM_TB_AMD amd

            JOIN LDM_TB_MA ma
              ON ma.ma_id = amd.ma_id

            WHERE ma.grp_id = grpId
              AND ma.in_nego_flg = 'N'
              AND NVL(ma.status_id, -1) <> 8
              AND amd.amd_id > 0
              AND amd.amd_d_sign IS NOT NULL
              AND amd.amd_d_term IS NULL
        )
        GROUP BY amd_d_sign,
                 occurrence_no
    );

    ---------------------------------------------------------------------------
    -- Preserve group-level execution-document references before changing
    -- amendment IDs.
    ---------------------------------------------------------------------------
    INSERT INTO EXEC_DOC_GRP_REF_TABLE
    (
        ROW_ID,
        EXEC_DATE,
        ROWID_AMD
    )
    SELECT row_id,
           exec_date,
           rowid_amd
    FROM
    (
        SELECT negoGrp.row_id AS row_id,
               amd.amd_d_sign AS exec_date,
               amd.ROWID AS rowid_amd,

               ROW_NUMBER() OVER
               (
                   PARTITION BY negoGrp.row_id
                   ORDER BY amd.amd_id DESC,
                            amd.date_creat,
                            amd.ROWID
               ) AS rn

        FROM LDM_TB_AMD amd

        JOIN LDM_TB_MA ma
          ON ma.ma_id = amd.ma_id

        JOIN NEGO_TB_ROW_EXEC_DOC_FOR_GRP negoGrp
          ON negoGrp.grp_id = grpId
         AND negoGrp.amd_id = amd.amd_id

        WHERE ma.grp_id = grpId
          AND NVL(ma.status_id, -1) <> 8
          AND amd.amd_id > 0
          AND amd.amd_d_sign IS NOT NULL
          AND amd.amd_d_term IS NULL
    )
    WHERE rn = 1;

    ---------------------------------------------------------------------------
    -- Process every eligible MA in the group
    ---------------------------------------------------------------------------
    FOR Eachma IN
    (
        SELECT ma_id
        FROM LDM_TB_MA
        WHERE grp_id = grpId
          AND in_nego_flg = 'N'
          AND NVL(status_id, -1) <> 8
        ORDER BY ma_id
    )
    LOOP
        -----------------------------------------------------------------------
        -- Clear per-MA temporary reference data
        -----------------------------------------------------------------------
        DELETE FROM EXEC_DOC_REF_TABLE;
        DELETE FROM AMD_VALDN_REF_TABLE;

        V_Amd_Rowids.DELETE;
        V_Old_Amd_Ids.DELETE;
        V_New_Amd_Ids.DELETE;
        V_Temp_Amd_Ids.DELETE;

        -----------------------------------------------------------------------
        -- Build the final amendment mapping.
        --
        -- Only amendments whose current AMD_ID differs from the calculated
        -- AMD_ID are selected.
        -----------------------------------------------------------------------
        SELECT rowid_amd,
               old_amd_id,
               new_amd_id
        BULK COLLECT INTO
               V_Amd_Rowids,
               V_Old_Amd_Ids,
               V_New_Amd_Ids
        FROM
        (
            SELECT amdt.rowid_amd,
                   amdt.old_amd_id,
                   reft.idx_no AS new_amd_id

            FROM
            (
                SELECT amd.ROWID AS rowid_amd,
                       amd.amd_id AS old_amd_id,
                       amd.amd_d_sign,

                       ROW_NUMBER() OVER
                       (
                           PARTITION BY amd.amd_d_sign
                           ORDER BY amd.date_creat,
                                    amd.ROWID
                       ) AS rn_amd

                FROM LDM_TB_AMD amd

                WHERE amd.ma_id = Eachma.ma_id
                  AND amd.amd_id > 0
                  AND amd.amd_d_sign IS NOT NULL
                  AND amd.amd_d_term IS NULL
            ) amdt

            JOIN
            (
                SELECT idx_no,
                       exec_date,

                       ROW_NUMBER() OVER
                       (
                           PARTITION BY exec_date
                           ORDER BY idx_no
                       ) AS rn_ref

                FROM AMD_REF_TABLE
            ) reft
              ON reft.exec_date = amdt.amd_d_sign
             AND reft.rn_ref = amdt.rn_amd

            WHERE amdt.old_amd_id <> reft.idx_no
        )
        ORDER BY new_amd_id,
                 rowid_amd;

        -----------------------------------------------------------------------
        -- Continue only if the current MA requires renumbering
        -----------------------------------------------------------------------
        IF V_Amd_Rowids.COUNT > 0 THEN

            -------------------------------------------------------------------
            -- Preserve execution-document references before changing AMD_ID
            -------------------------------------------------------------------
            INSERT INTO EXEC_DOC_REF_TABLE
            (
                ROW_ID,
                EXEC_DATE,
                ROWID_AMD
            )
            SELECT nego.row_id,
                   amd.amd_d_sign,
                   amd.ROWID

            FROM NEGO_TB_ROW_EXEC_DOC nego

            JOIN LDM_TB_AMD amd
              ON amd.ma_id = nego.ma_id
             AND amd.amd_id = nego.amd_id

            WHERE amd.ma_id = Eachma.ma_id
              AND amd.amd_id > 0
              AND amd.amd_d_term IS NULL;

            -------------------------------------------------------------------
            -- Preserve amendment-validation references before changing AMD_ID
            -------------------------------------------------------------------
            INSERT INTO AMD_VALDN_REF_TABLE
            (
                AMD_ID,
                ROWID_VALDN,
                ROWID_AMD
            )
            SELECT valdn.amendment_id,
                   valdn.ROWID,
                   amd.ROWID

            FROM AMENDMENT_VALIDATIONS valdn

            JOIN LDM_TB_AMD amd
              ON amd.ma_id = valdn.agreement_id
             AND amd.amd_id = valdn.amendment_id

            WHERE amd.ma_id = Eachma.ma_id
              AND amd.amd_id > 0
              AND amd.amd_d_term IS NULL
              AND valdn.validator IS NOT NULL;

            -------------------------------------------------------------------
            -- Calculate a safe temporary amendment-ID range
            -------------------------------------------------------------------
            SELECT NVL(MAX(ABS(amd_id)), 0) + 1000
            INTO v_temp_base
            FROM LDM_TB_AMD
            WHERE ma_id = Eachma.ma_id;

            -------------------------------------------------------------------
            -- Build temporary IDs before using FORALL.
            --
            -- The FORALL iterator cannot be used directly in an arithmetic
            -- expression such as V_TEMP_BASE + I.
            -------------------------------------------------------------------
            FOR i IN 1 .. V_Amd_Rowids.COUNT
            LOOP
                V_Temp_Amd_Ids(i) := v_temp_base + i;
            END LOOP;

            -------------------------------------------------------------------
            -- Phase 1: move affected amendments to temporary IDs
            -------------------------------------------------------------------
            FORALL i IN INDICES OF V_Amd_Rowids
                UPDATE LDM_TB_AMD
                SET amd_id     = V_Temp_Amd_Ids(i),
                    date_modif = SYSDATE,
                    user_modif = Cuser
                WHERE ROWID = V_Amd_Rowids(i);

            -------------------------------------------------------------------
            -- Phase 2: assign final sorted amendment IDs
            -------------------------------------------------------------------
            FORALL i IN INDICES OF V_Amd_Rowids
                UPDATE LDM_TB_AMD
                SET amd_id     = V_New_Amd_Ids(i),
                    date_modif = SYSDATE,
                    user_modif = Cuser
                WHERE ROWID = V_Amd_Rowids(i);

            -------------------------------------------------------------------
            -- Update individual execution-document references
            -------------------------------------------------------------------
            MERGE INTO NEGO_TB_ROW_EXEC_DOC exec_doc
            USING
            (
                SELECT amd.amd_id AS new_id,
                       reft.row_id AS ref_row_id

                FROM EXEC_DOC_REF_TABLE reft

                JOIN LDM_TB_AMD amd
                  ON amd.ROWID = reft.rowid_amd

                WHERE amd.ma_id = Eachma.ma_id
                  AND amd.amd_d_term IS NULL
            ) data_t
            ON
            (
                exec_doc.row_id = data_t.ref_row_id
                AND exec_doc.ma_id = Eachma.ma_id
            )
            WHEN MATCHED THEN
                UPDATE SET
                    exec_doc.amd_id     = data_t.new_id,
                    exec_doc.user_modif = Cuser,
                    exec_doc.date_modif = SYSDATE
                WHERE NVL(exec_doc.amd_id, -1)
                   <> NVL(data_t.new_id, -1);

            -------------------------------------------------------------------
            -- Preserve the existing validation-update behaviour.
            --
            -- This section has intentionally not been converted into a
            -- different bulk mapping algorithm, to avoid introducing new
            -- validation constraint or mapping errors.
            -------------------------------------------------------------------
            FOR Eachamdref IN
            (
                SELECT amd_id,
                       rowid_valdn,
                       rowid_amd
                FROM AMD_VALDN_REF_TABLE
                ORDER BY rowid_valdn
            )
            LOOP
                SELECT amd_id
                INTO To_Amd_Id
                FROM LDM_TB_AMD
                WHERE ROWID = Eachamdref.rowid_amd;

                IF To_Amd_Id <> Eachamdref.amd_id THEN

                    -----------------------------------------------------------
                    -- Temporarily move another validation row that currently
                    -- occupies the target amendment ID
                    -----------------------------------------------------------
                    UPDATE AMENDMENT_VALIDATIONS
                    SET amendment_id =
                        (
                            SELECT NVL(MAX(ABS(amendment_id)), 0) + 1000
                            FROM AMENDMENT_VALIDATIONS
                            WHERE agreement_id = Eachma.ma_id
                        )
                    WHERE agreement_id = Eachma.ma_id
                      AND amendment_id = To_Amd_Id
                      AND ROWID <> Eachamdref.rowid_valdn;

                    -----------------------------------------------------------
                    -- Update the exact validation row
                    -----------------------------------------------------------
                    UPDATE AMENDMENT_VALIDATIONS
                    SET amendment_id = To_Amd_Id
                    WHERE ROWID = Eachamdref.rowid_valdn;

                END IF;
            END LOOP;

        END IF;

        -----------------------------------------------------------------------
        -- Clear current MA references
        -----------------------------------------------------------------------
        DELETE FROM EXEC_DOC_REF_TABLE;
        DELETE FROM AMD_VALDN_REF_TABLE;

        V_Amd_Rowids.DELETE;
        V_Old_Amd_Ids.DELETE;
        V_New_Amd_Ids.DELETE;
        V_Temp_Amd_Ids.DELETE;

    END LOOP;

    ---------------------------------------------------------------------------
    -- Update group-level execution-document amendment IDs
    ---------------------------------------------------------------------------
    MERGE INTO NEGO_TB_ROW_EXEC_DOC_FOR_GRP exec_doc_grp
    USING
    (
        SELECT new_id,
               ref_row_id
        FROM
        (
            SELECT amd.amd_id AS new_id,
                   reft.row_id AS ref_row_id,

                   ROW_NUMBER() OVER
                   (
                       PARTITION BY reft.row_id
                       ORDER BY amd.amd_id DESC,
                                amd.ROWID
                   ) AS rn

            FROM EXEC_DOC_GRP_REF_TABLE reft

            JOIN LDM_TB_AMD amd
              ON amd.ROWID = reft.rowid_amd

            WHERE amd.amd_d_term IS NULL
        )
        WHERE rn = 1
    ) data_t
    ON
    (
        exec_doc_grp.row_id = data_t.ref_row_id
        AND exec_doc_grp.grp_id = grpId
    )
    WHEN MATCHED THEN
        UPDATE SET
            exec_doc_grp.amd_id     = data_t.new_id,
            exec_doc_grp.user_modif = Cuser,
            exec_doc_grp.date_modif = SYSDATE
        WHERE NVL(exec_doc_grp.amd_id, -1)
           <> NVL(data_t.new_id, -1);

    ---------------------------------------------------------------------------
    -- Final cleanup
    ---------------------------------------------------------------------------
    DELETE FROM AMD_REF_TABLE;
    DELETE FROM EXEC_DOC_REF_TABLE;
    DELETE FROM AMD_VALDN_REF_TABLE;
    DELETE FROM EXEC_DOC_GRP_REF_TABLE;

    COMMIT;

EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK TO before_sort_amendments_group;

        BEGIN
            DELETE FROM AMD_REF_TABLE;
            DELETE FROM EXEC_DOC_REF_TABLE;
            DELETE FROM AMD_VALDN_REF_TABLE;
            DELETE FROM EXEC_DOC_GRP_REF_TABLE;
        EXCEPTION
            WHEN OTHERS THEN
                NULL;
        END;

        RAISE;

END SORT_AMENDMENTS_GROUP;
/