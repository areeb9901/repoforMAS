CREATE OR REPLACE PROCEDURE SORT_AMENDMENTS_GROUP
(
    grpId NUMBER,
    Cuser VARCHAR2
)
AS
    v_group_slot_count      NUMBER := 0;
    v_temp_base             NUMBER := 0;
    v_validation_temp_base  NUMBER := 0;
    v_duplicate_count       NUMBER := 0;
    v_before_row_count      NUMBER := 0;
    v_after_row_count       NUMBER := 0;

BEGIN
    SAVEPOINT before_sort_amendments_group;

    ---------------------------------------------------------------------------
    -- Clean working tables
    ---------------------------------------------------------------------------
    DELETE FROM AMD_REF_TABLE;
    DELETE FROM EXEC_DOC_REF_TABLE;
    DELETE FROM AMD_VALDN_REF_TABLE;
    DELETE FROM EXEC_DOC_GRP_REF_TABLE;

    ---------------------------------------------------------------------------
    -- Record physical row count.
    -- The procedure must never add or remove amendment rows.
    ---------------------------------------------------------------------------
    SELECT COUNT(*)
    INTO v_before_row_count
    FROM LDM_TB_AMD amd
    JOIN LDM_TB_MA ma
      ON ma.ma_id = amd.ma_id
    WHERE ma.grp_id = grpId
      AND amd.amd_id > 0;

    ---------------------------------------------------------------------------
    -- Lock all MAs in the group to prevent two concurrent sorts.
    ---------------------------------------------------------------------------
    FOR LockRow IN
    (
        SELECT ma.ma_id
        FROM LDM_TB_MA ma
        WHERE ma.grp_id = grpId
        ORDER BY ma.ma_id
        FOR UPDATE
    )
    LOOP
        NULL;
    END LOOP;

    ---------------------------------------------------------------------------
    -- Build the authoritative signed-amendment sequence.
    --
    -- Critical rule:
    --   Sequence is based on signing date + occurrence number.
    --
    -- Example:
    -- If one MA contains 23-NOV-2011 twice, the group receives two slots:
    --
    --   23-NOV-2011 occurrence 1
    --   23-NOV-2011 occurrence 2
    --
    -- If hundreds of MAs contain those same two occurrences, the group still
    -- receives only two slots for the date.
    --
    -- Existing AMD_ID is deliberately not used.
    --
    -- Terminated MAs are excluded from the legacy sorting process.
    ---------------------------------------------------------------------------
    INSERT INTO AMD_REF_TABLE
    (
        IDX_NO,
        EXEC_DATE
    )
    WITH Eligible_Amendments AS
    (
        SELECT amd.ma_id,
               amd.amd_d_sign,

               ROW_NUMBER() OVER
               (
                   PARTITION BY amd.ma_id,
                                amd.amd_d_sign
                   ORDER BY amd.date_creat,
                            amd.ROWID
               ) AS date_occurrence
        FROM LDM_TB_AMD amd
        JOIN LDM_TB_MA ma
          ON ma.ma_id = amd.ma_id
        WHERE ma.grp_id = grpId
          AND ma.in_nego_flg = 'N'
          AND NVL(ma.status_id, -1) <> 8
          AND amd.amd_id > 0
          AND amd.amd_d_sign IS NOT NULL
    ),
    Date_Requirements AS
    (
        SELECT amd_d_sign,
               MAX(date_occurrence) AS required_occurrences
        FROM Eligible_Amendments
        GROUP BY amd_d_sign
    ),
    Numbers AS
    (
        SELECT LEVEL AS occurrence_no
        FROM dual
        CONNECT BY LEVEL <=
        (
            SELECT NVL(
                       MAX(required_occurrences),
                       0
                   )
            FROM Date_Requirements
        )
    ),
    Group_Slots AS
    (
        SELECT dates.amd_d_sign,
               numbers.occurrence_no
        FROM Date_Requirements dates
        JOIN Numbers numbers
          ON numbers.occurrence_no <=
             dates.required_occurrences
    )
    SELECT ROW_NUMBER() OVER
           (
               ORDER BY amd_d_sign,
                        occurrence_no
           ) AS idx_no,
           amd_d_sign AS exec_date
    FROM Group_Slots;

    SELECT COUNT(*)
    INTO v_group_slot_count
    FROM AMD_REF_TABLE;

    ---------------------------------------------------------------------------
    -- Preserve group executed-document references before renumbering.
    --
    -- Only eligible, non-terminated MAs participate because only those rows
    -- are sorted.
    ---------------------------------------------------------------------------
    INSERT INTO EXEC_DOC_GRP_REF_TABLE
    (
        ROW_ID,
        EXEC_DATE,
        ROWID_AMD
    )
    SELECT row_id,
           exec_date,
           rowid_amd
    FROM
    (
        SELECT grp_doc.row_id AS row_id,
               amd.amd_d_sign AS exec_date,
               amd.ROWID AS rowid_amd,

               ROW_NUMBER() OVER
               (
                   PARTITION BY grp_doc.row_id
                   ORDER BY amd.date_creat,
                            amd.ROWID
               ) AS rn
        FROM NEGO_TB_ROW_EXEC_DOC_FOR_GRP grp_doc
        JOIN LDM_TB_MA ma
          ON ma.grp_id = grp_doc.grp_id
        JOIN LDM_TB_AMD amd
          ON amd.ma_id = ma.ma_id
         AND amd.amd_id = grp_doc.amd_id
        WHERE grp_doc.grp_id = grpId
          AND ma.in_nego_flg = 'N'
          AND NVL(ma.status_id, -1) <> 8
          AND amd.amd_id > 0
    )
    WHERE rn = 1;

    ---------------------------------------------------------------------------
    -- Sort each eligible MA.
    ---------------------------------------------------------------------------
    FOR Eachma IN
    (
        SELECT ma.ma_id
        FROM LDM_TB_MA ma
        WHERE ma.grp_id = grpId
          AND ma.in_nego_flg = 'N'
          AND NVL(ma.status_id, -1) <> 8
        ORDER BY ma.ma_id
    )
    LOOP
        DELETE FROM EXEC_DOC_REF_TABLE;
        DELETE FROM AMD_VALDN_REF_TABLE;

        -----------------------------------------------------------------------
        -- Preserve individual executed-document references.
        --
        -- Existing AMD_ID is used only to locate the referenced physical row
        -- before renumbering.
        -----------------------------------------------------------------------
        INSERT INTO EXEC_DOC_REF_TABLE
        (
            ROW_ID,
            EXEC_DATE,
            ROWID_AMD
        )
        SELECT row_id,
               exec_date,
               rowid_amd
        FROM
        (
            SELECT exec_doc.row_id AS row_id,
                   amd.amd_d_sign AS exec_date,
                   amd.ROWID AS rowid_amd,

                   ROW_NUMBER() OVER
                   (
                       PARTITION BY exec_doc.row_id
                       ORDER BY amd.date_creat,
                                amd.ROWID
                   ) AS rn
            FROM NEGO_TB_ROW_EXEC_DOC exec_doc
            JOIN LDM_TB_AMD amd
              ON amd.ma_id = exec_doc.ma_id
             AND amd.amd_id = exec_doc.amd_id
            WHERE exec_doc.ma_id = Eachma.ma_id
              AND amd.amd_id > 0
        )
        WHERE rn = 1;

        -----------------------------------------------------------------------
        -- Preserve amendment-validation references.
        -----------------------------------------------------------------------
        INSERT INTO AMD_VALDN_REF_TABLE
        (
            AMD_ID,
            ROWID_VALDN,
            ROWID_AMD
        )
        SELECT amd_id,
               rowid_valdn,
               rowid_amd
        FROM
        (
            SELECT valdn.amendment_id AS amd_id,
                   valdn.ROWID AS rowid_valdn,
                   amd.ROWID AS rowid_amd,

                   ROW_NUMBER() OVER
                   (
                       PARTITION BY valdn.ROWID
                       ORDER BY amd.date_creat,
                                amd.ROWID
                   ) AS rn
            FROM AMENDMENT_VALIDATIONS valdn
            JOIN LDM_TB_AMD amd
              ON amd.ma_id = valdn.agreement_id
             AND amd.amd_id = valdn.amendment_id
            WHERE valdn.agreement_id = Eachma.ma_id
              AND valdn.validator IS NOT NULL
              AND amd.amd_id > 0
        )
        WHERE rn = 1;

        -----------------------------------------------------------------------
        -- Calculate a temporary range above every existing AMD_ID for this MA.
        -----------------------------------------------------------------------
        SELECT NVL(MAX(ABS(amd_id)), 0)
               + COUNT(*)
               + v_group_slot_count
               + 1000
        INTO v_temp_base
        FROM LDM_TB_AMD
        WHERE ma_id = Eachma.ma_id
          AND amd_id > 0;

        -----------------------------------------------------------------------
        -- PHASE 1:
        -- Move every positive amendment row to a unique temporary AMD_ID.
        --
        -- This prevents collisions between:
        --   old signed rows,
        --   newly sorted signed rows,
        --   unsigned rows.
        -----------------------------------------------------------------------
        MERGE INTO LDM_TB_AMD target_amd
        USING
        (
            SELECT amd.ROWID AS rowid_amd,
                   v_temp_base
                   + ROW_NUMBER() OVER
                     (
                         ORDER BY amd.amd_id,
                                  amd.date_creat,
                                  amd.ROWID
                     ) AS temporary_amd_id
            FROM LDM_TB_AMD amd
            WHERE amd.ma_id = Eachma.ma_id
              AND amd.amd_id > 0
        ) source_data
        ON
        (
            target_amd.ROWID = source_data.rowid_amd
        )
        WHEN MATCHED THEN
            UPDATE SET
                target_amd.amd_id =
                    source_data.temporary_amd_id,

                target_amd.date_modif =
                    SYSDATE,

                target_amd.user_modif =
                    Cuser;

        -----------------------------------------------------------------------
        -- PHASE 2:
        -- Assign final IDs.
        --
        -- Signed amendments:
        --   Map by signing date + occurrence.
        --
        -- Unsigned amendments:
        --   Place after the complete signed group sequence.
        --
        -- No row is inserted or deleted.
        -----------------------------------------------------------------------
        MERGE INTO LDM_TB_AMD target_amd
        USING
        (
            WITH Ma_Signed_Amendments AS
            (
                SELECT amd.ROWID AS rowid_amd,
                       amd.amd_d_sign,

                       ROW_NUMBER() OVER
                       (
                           PARTITION BY amd.amd_d_sign
                           ORDER BY amd.date_creat,
                                    amd.ROWID
                       ) AS date_occurrence
                FROM LDM_TB_AMD amd
                WHERE amd.ma_id = Eachma.ma_id
                  AND amd.amd_id > v_temp_base
                  AND amd.amd_d_sign IS NOT NULL
            ),
            Group_Reference AS
            (
                SELECT ref.idx_no,
                       ref.exec_date,

                       ROW_NUMBER() OVER
                       (
                           PARTITION BY ref.exec_date
                           ORDER BY ref.idx_no
                       ) AS date_occurrence
                FROM AMD_REF_TABLE ref
            ),
            Signed_Mapping AS
            (
                SELECT ma_amd.rowid_amd,
                       ref.idx_no AS final_amd_id
                FROM Ma_Signed_Amendments ma_amd
                JOIN Group_Reference ref
                  ON ref.exec_date =
                     ma_amd.amd_d_sign

                 AND ref.date_occurrence =
                     ma_amd.date_occurrence
            ),
            Unsigned_Mapping AS
            (
                SELECT amd.ROWID AS rowid_amd,

                       v_group_slot_count
                       + ROW_NUMBER() OVER
                         (
                             ORDER BY amd.date_creat,
                                      amd.ROWID
                         ) AS final_amd_id
                FROM LDM_TB_AMD amd
                WHERE amd.ma_id = Eachma.ma_id
                  AND amd.amd_id > v_temp_base
                  AND amd.amd_d_sign IS NULL
            )
            SELECT rowid_amd,
                   final_amd_id
            FROM Signed_Mapping

            UNION ALL

            SELECT rowid_amd,
                   final_amd_id
            FROM Unsigned_Mapping
        ) source_data
        ON
        (
            target_amd.ROWID = source_data.rowid_amd
        )
        WHEN MATCHED THEN
            UPDATE SET
                target_amd.amd_id =
                    source_data.final_amd_id,

                target_amd.date_modif =
                    SYSDATE,

                target_amd.user_modif =
                    Cuser;

        -----------------------------------------------------------------------
        -- Ensure no temporary AMD_ID was left behind.
        -----------------------------------------------------------------------
        SELECT COUNT(*)
        INTO v_duplicate_count
        FROM LDM_TB_AMD
        WHERE ma_id = Eachma.ma_id
          AND amd_id > v_temp_base;

        IF v_duplicate_count > 0 THEN
            RAISE_APPLICATION_ERROR
            (
                -20010,
                'Unmapped amendment rows remain for MA '
                || Eachma.ma_id
            );
        END IF;

        -----------------------------------------------------------------------
        -- Update individual executed-document references using physical ROWID.
        -----------------------------------------------------------------------
        MERGE INTO NEGO_TB_ROW_EXEC_DOC target_doc
        USING
        (
            SELECT ref.row_id AS ref_row_id,
                   amd.amd_id AS final_amd_id
            FROM EXEC_DOC_REF_TABLE ref
            JOIN LDM_TB_AMD amd
              ON amd.ROWID = ref.rowid_amd
            WHERE amd.ma_id = Eachma.ma_id
        ) source_data
        ON
        (
            target_doc.row_id = source_data.ref_row_id
            AND target_doc.ma_id = Eachma.ma_id
        )
        WHEN MATCHED THEN
            UPDATE SET
                target_doc.amd_id =
                    source_data.final_amd_id,

                target_doc.user_modif =
                    Cuser,

                target_doc.date_modif =
                    SYSDATE;

        -----------------------------------------------------------------------
        -- Temporarily move validation IDs to prevent collisions.
        -----------------------------------------------------------------------
        SELECT NVL(MAX(ABS(amendment_id)), 0)
               + COUNT(*)
               + v_group_slot_count
               + 1000
        INTO v_validation_temp_base
        FROM AMENDMENT_VALIDATIONS
        WHERE agreement_id = Eachma.ma_id;

        MERGE INTO AMENDMENT_VALIDATIONS target_valdn
        USING
        (
            SELECT ref.rowid_valdn,
                   v_validation_temp_base
                   + ROW_NUMBER() OVER
                     (
                         ORDER BY ref.rowid_valdn
                     ) AS temporary_amd_id
            FROM AMD_VALDN_REF_TABLE ref
        ) source_data
        ON
        (
            target_valdn.ROWID =
                source_data.rowid_valdn
        )
        WHEN MATCHED THEN
            UPDATE SET
                target_valdn.amendment_id =
                    source_data.temporary_amd_id;

        -----------------------------------------------------------------------
        -- Assign final validation IDs from the referenced amendment ROWID.
        -----------------------------------------------------------------------
        MERGE INTO AMENDMENT_VALIDATIONS target_valdn
        USING
        (
            SELECT ref.rowid_valdn,
                   amd.amd_id AS final_amd_id
            FROM AMD_VALDN_REF_TABLE ref
            JOIN LDM_TB_AMD amd
              ON amd.ROWID = ref.rowid_amd
        ) source_data
        ON
        (
            target_valdn.ROWID =
                source_data.rowid_valdn
        )
        WHEN MATCHED THEN
            UPDATE SET
                target_valdn.amendment_id =
                    source_data.final_amd_id;

        -----------------------------------------------------------------------
        -- No duplicate AMD_ID may exist inside an MA.
        -----------------------------------------------------------------------
        SELECT COUNT(*)
        INTO v_duplicate_count
        FROM
        (
            SELECT amd_id
            FROM LDM_TB_AMD
            WHERE ma_id = Eachma.ma_id
              AND amd_id > 0
            GROUP BY amd_id
            HAVING COUNT(*) > 1
        );

        IF v_duplicate_count > 0 THEN
            RAISE_APPLICATION_ERROR
            (
                -20011,
                'Duplicate AMD_ID generated for MA '
                || Eachma.ma_id
            );
        END IF;

        DELETE FROM EXEC_DOC_REF_TABLE;
        DELETE FROM AMD_VALDN_REF_TABLE;
    END LOOP;

    ---------------------------------------------------------------------------
    -- Update group-level executed-document references.
    ---------------------------------------------------------------------------
    MERGE INTO NEGO_TB_ROW_EXEC_DOC_FOR_GRP target_grp_doc
    USING
    (
        SELECT ref.row_id AS ref_row_id,
               amd.amd_id AS final_amd_id
        FROM EXEC_DOC_GRP_REF_TABLE ref
        JOIN LDM_TB_AMD amd
          ON amd.ROWID = ref.rowid_amd
    ) source_data
    ON
    (
        target_grp_doc.row_id =
            source_data.ref_row_id

        AND target_grp_doc.grp_id =
            grpId
    )
    WHEN MATCHED THEN
        UPDATE SET
            target_grp_doc.amd_id =
                source_data.final_amd_id,

            target_grp_doc.user_modif =
                Cuser,

            target_grp_doc.date_modif =
                SYSDATE;

    ---------------------------------------------------------------------------
    -- Final group duplicate check.
    ---------------------------------------------------------------------------
    SELECT COUNT(*)
    INTO v_duplicate_count
    FROM
    (
        SELECT amd.ma_id,
               amd.amd_id
        FROM LDM_TB_AMD amd
        JOIN LDM_TB_MA ma
          ON ma.ma_id = amd.ma_id
        WHERE ma.grp_id = grpId
          AND ma.in_nego_flg = 'N'
          AND NVL(ma.status_id, -1) <> 8
          AND amd.amd_id > 0
        GROUP BY amd.ma_id,
                 amd.amd_id
        HAVING COUNT(*) > 1
    );

    IF v_duplicate_count > 0 THEN
        RAISE_APPLICATION_ERROR
        (
            -20012,
            'Duplicate AMD_ID values remain for group '
            || grpId
        );
    END IF;

    ---------------------------------------------------------------------------
    -- Confirm that no amendment row was inserted or deleted.
    ---------------------------------------------------------------------------
    SELECT COUNT(*)
    INTO v_after_row_count
    FROM LDM_TB_AMD amd
    JOIN LDM_TB_MA ma
      ON ma.ma_id = amd.ma_id
    WHERE ma.grp_id = grpId
      AND amd.amd_id > 0;

    IF v_before_row_count <> v_after_row_count THEN
        RAISE_APPLICATION_ERROR
        (
            -20013,
            'Amendment row count changed for group '
            || grpId
            || '. Before='
            || v_before_row_count
            || ', After='
            || v_after_row_count
        );
    END IF;

    ---------------------------------------------------------------------------
    -- Cleanup
    ---------------------------------------------------------------------------
    DELETE FROM AMD_REF_TABLE;
    DELETE FROM EXEC_DOC_REF_TABLE;
    DELETE FROM AMD_VALDN_REF_TABLE;
    DELETE FROM EXEC_DOC_GRP_REF_TABLE;

    COMMIT;

EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK TO before_sort_amendments_group;

        BEGIN
            DELETE FROM AMD_REF_TABLE;
            DELETE FROM EXEC_DOC_REF_TABLE;
            DELETE FROM AMD_VALDN_REF_TABLE;
            DELETE FROM EXEC_DOC_GRP_REF_TABLE;
        EXCEPTION
            WHEN OTHERS THEN
                NULL;
        END;

        RAISE;
END SORT_AMENDMENTS_GROUP;
/