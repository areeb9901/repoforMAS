CREATE OR REPLACE PROCEDURE SORT_AMENDMENTS_GROUP
(
    grpId NUMBER,
    Cuser VARCHAR2
)
AS
    To_Amd_Id NUMBER;

BEGIN
    ---------------------------------------------------------------------------
    -- Clear temporary/reference tables
    ---------------------------------------------------------------------------
    DELETE FROM AMD_REF_TABLE;
    DELETE FROM EXEC_DOC_REF_TABLE;
    DELETE FROM AMD_VALDN_REF_TABLE;
    DELETE FROM EXEC_DOC_GRP_REF_TABLE;

    ---------------------------------------------------------------------------
    -- FIX 1:
    --
    -- Build the complete amendment sequence for the group.
    --
    -- The original query used:
    --
    -- ROW_NUMBER() OVER (PARTITION BY AMD_ID ...)
    -- WHERE RN = 1
    --
    -- That retained only one date for an AMD_ID and ignored additional dates.
    --
    -- We now retain every distinct AMD_ID + AMD_D_SIGN combination.
    --
    -- Examples:
    --
    -- AMD_ID 1 / 26-APR-2017
    -- AMD_ID 2 / 01-MAY-2017
    -- AMD_ID 2 / 18-MAY-2017
    -- AMD_ID 2 / 01-JUN-2017
    --
    -- All four dates participate in the group reference sequence.
    --
    -- No terminated-agreement filter is applied here because all dates present
    -- in the group must be considered while constructing the group sequence.
    ---------------------------------------------------------------------------
    INSERT INTO AMD_REF_TABLE
    (
        IDX_NO,
        EXEC_DATE
    )
    SELECT ROW_NUMBER() OVER
           (
               ORDER BY source_data.amd_d_sign,
                        source_data.amd_id
           ) AS idx_no,
           source_data.amd_d_sign
    FROM
    (
        SELECT DISTINCT
               amd.amd_id,
               amd.amd_d_sign
        FROM LDM_TB_AMD amd
        JOIN LDM_TB_MA ma
          ON ma.ma_id = amd.ma_id
        WHERE ma.grp_id = grpId
          AND amd.amd_d_sign IS NOT NULL
          AND amd.amd_id > 0
    ) source_data;

    ---------------------------------------------------------------------------
    -- Save references for group-level executed documents before AMD_ID values
    -- are changed.
    --
    -- Partition by the executed-document ROW_ID, not by AMD_ID. One reference
    -- row must be retained for each executed-document row.
    --
    -- Prefer a non-terminated MA when the same old AMD_ID is found in several
    -- MAs. Dates from terminated MAs remain available as a fallback.
    ---------------------------------------------------------------------------
    INSERT INTO EXEC_DOC_GRP_REF_TABLE
    (
        ROW_ID,
        EXEC_DATE,
        ROWID_AMD
    )
    SELECT row_id,
           exec_date,
           rowid_amd
    FROM
    (
        SELECT nego_grp.row_id AS row_id,
               amd.amd_d_sign AS exec_date,
               amd.ROWID AS rowid_amd,

               ROW_NUMBER() OVER
               (
                   PARTITION BY nego_grp.row_id
                   ORDER BY
                       CASE
                           WHEN NVL(ma.status_id, -1) <> 8
                           THEN 0
                           ELSE 1
                       END,
                       amd.date_creat,
                       amd.ROWID
               ) AS rn
        FROM NEGO_TB_ROW_EXEC_DOC_FOR_GRP nego_grp
        JOIN LDM_TB_MA ma
          ON ma.grp_id = nego_grp.grp_id
        JOIN LDM_TB_AMD amd
          ON amd.ma_id = ma.ma_id
         AND amd.amd_id = nego_grp.amd_id
        WHERE nego_grp.grp_id = grpId
          AND amd.amd_d_sign IS NOT NULL
          AND amd.amd_id > 0
    )
    WHERE rn = 1;

    ---------------------------------------------------------------------------
    -- FIX 2:
    --
    -- Sort only non-terminated agreements.
    --
    -- Dates from terminated agreements were included in AMD_REF_TABLE above,
    -- but their LDM_TB_AMD rows are not renumbered here.
    --
    -- Once an MA is unterminated, STATUS_ID is no longer 8. Therefore, when
    -- this procedure is called during untermination, that MA participates in
    -- the sorting process.
    ---------------------------------------------------------------------------
    FOR Eachma IN
    (
        SELECT ma.ma_id
        FROM LDM_TB_MA ma
        WHERE ma.grp_id = grpId
          AND ma.in_nego_flg = 'N'
          AND NVL(ma.status_id, -1) <> 8
        ORDER BY ma.ma_id
    )
    LOOP
        -----------------------------------------------------------------------
        -- Clear MA-specific reference data
        -----------------------------------------------------------------------
        DELETE FROM EXEC_DOC_REF_TABLE;
        DELETE FROM AMD_VALDN_REF_TABLE;

        -----------------------------------------------------------------------
        -- Save executed-document references before changing AMD_ID.
        --
        -- No AMD_D_TERM filter is applied. Terminated amendment rows must
        -- remain available when amendment dates are updated.
        -----------------------------------------------------------------------
        INSERT INTO EXEC_DOC_REF_TABLE
        (
            ROW_ID,
            EXEC_DATE,
            ROWID_AMD
        )
        SELECT row_id,
               exec_date,
               rowid_amd
        FROM
        (
            SELECT nego.row_id AS row_id,
                   amd.amd_d_sign AS exec_date,
                   amd.ROWID AS rowid_amd,

                   ROW_NUMBER() OVER
                   (
                       PARTITION BY nego.row_id
                       ORDER BY amd.date_creat,
                                amd.ROWID
                   ) AS rn
            FROM NEGO_TB_ROW_EXEC_DOC nego
            JOIN LDM_TB_AMD amd
              ON amd.ma_id = nego.ma_id
             AND amd.amd_id = nego.amd_id
            WHERE amd.ma_id = Eachma.ma_id
              AND amd.amd_id > 0
        )
        WHERE rn = 1;

        -----------------------------------------------------------------------
        -- Save amendment-validation references
        -----------------------------------------------------------------------
        INSERT INTO AMD_VALDN_REF_TABLE
        (
            AMD_ID,
            ROWID_VALDN,
            ROWID_AMD
        )
        SELECT amd_id,
               rowid_valdn,
               rowid_amd
        FROM
        (
            SELECT valdn.amendment_id AS amd_id,
                   valdn.ROWID AS rowid_valdn,
                   amd.ROWID AS rowid_amd,

                   ROW_NUMBER() OVER
                   (
                       PARTITION BY valdn.ROWID
                       ORDER BY amd.date_creat,
                                amd.ROWID
                   ) AS rn
            FROM AMENDMENT_VALIDATIONS valdn
            JOIN LDM_TB_AMD amd
              ON amd.ma_id = valdn.agreement_id
             AND amd.amd_id = valdn.amendment_id
            WHERE valdn.agreement_id = Eachma.ma_id
              AND valdn.validator IS NOT NULL
              AND amd.amd_id > 0
        )
        WHERE rn = 1;

        -----------------------------------------------------------------------
        -- Sort amendments for the current MA using the complete group
        -- reference sequence.
        --
        -- Repeated dates are supported through RN_AMD and RN_REF.
        --
        -- Example:
        --
        -- AMD_REF_TABLE
        -- ID 4  -> 23-NOV-2011, occurrence 1
        -- ID 5  -> 23-NOV-2011, occurrence 2
        --
        -- An MA having two amendments on 23-NOV-2011 will map both rows to
        -- their respective group slots.
        --
        -- DATE_CREAT and ROWID provide deterministic ordering.
        -----------------------------------------------------------------------
        MERGE INTO LDM_TB_AMD target_amd
        USING
        (
            SELECT amd_data.rowid_amd,
                   ref_data.idx_no AS new_amd_id
            FROM
            (
                SELECT amd.ROWID AS rowid_amd,
                       amd.amd_d_sign,

                       ROW_NUMBER() OVER
                       (
                           PARTITION BY amd.amd_d_sign
                           ORDER BY amd.date_creat,
                                    amd.ROWID
                       ) AS rn_amd
                FROM LDM_TB_AMD amd
                WHERE amd.ma_id = Eachma.ma_id
                  AND amd.amd_id > 0
                  AND amd.amd_d_sign IS NOT NULL
            ) amd_data
            JOIN
            (
                SELECT ref.idx_no,
                       ref.exec_date,

                       ROW_NUMBER() OVER
                       (
                           PARTITION BY ref.exec_date
                           ORDER BY ref.idx_no
                       ) AS rn_ref
                FROM AMD_REF_TABLE ref
            ) ref_data
              ON ref_data.exec_date = amd_data.amd_d_sign
             AND ref_data.rn_ref = amd_data.rn_amd
        ) source_data
        ON
        (
            target_amd.ROWID = source_data.rowid_amd
        )
        WHEN MATCHED THEN
            UPDATE SET
                target_amd.amd_id =
                    source_data.new_amd_id,

                target_amd.date_modif =
                    SYSDATE,

                target_amd.user_modif =
                    Cuser;

        -----------------------------------------------------------------------
        -- Update individual executed-document amendment references
        -----------------------------------------------------------------------
        MERGE INTO NEGO_TB_ROW_EXEC_DOC target_doc
        USING
        (
            SELECT ref.row_id AS ref_row_id,
                   amd.amd_id AS new_amd_id
            FROM EXEC_DOC_REF_TABLE ref
            JOIN LDM_TB_AMD amd
              ON amd.ROWID = ref.rowid_amd
            WHERE amd.ma_id = Eachma.ma_id
        ) source_data
        ON
        (
            target_doc.row_id = source_data.ref_row_id
            AND target_doc.ma_id = Eachma.ma_id
        )
        WHEN MATCHED THEN
            UPDATE SET
                target_doc.amd_id =
                    source_data.new_amd_id,

                target_doc.user_modif =
                    Cuser,

                target_doc.date_modif =
                    SYSDATE;

        -----------------------------------------------------------------------
        -- Update amendment-validation references.
        --
        -- Retain the original swap protection to prevent two validation rows
        -- from incorrectly receiving the same Amendment_Id during renumbering.
        -----------------------------------------------------------------------
        FOR Eachamdref IN
        (
            SELECT amd_id,
                   rowid_valdn,
                   rowid_amd
            FROM AMD_VALDN_REF_TABLE
            ORDER BY rowid_valdn
        )
        LOOP
            SELECT amd.amd_id
            INTO To_Amd_Id
            FROM LDM_TB_AMD amd
            WHERE amd.ROWID = Eachamdref.rowid_amd;

            IF To_Amd_Id <> Eachamdref.amd_id THEN
                UPDATE AMENDMENT_VALIDATIONS
                SET amendment_id = To_Amd_Id
                WHERE ROWID = Eachamdref.rowid_valdn;

                UPDATE AMENDMENT_VALIDATIONS
                SET amendment_id = Eachamdref.amd_id
                WHERE amendment_id = To_Amd_Id
                  AND agreement_id = Eachma.ma_id
                  AND ROWID <> Eachamdref.rowid_valdn;
            END IF;
        END LOOP;

        -----------------------------------------------------------------------
        -- Clear MA-specific working data
        -----------------------------------------------------------------------
        DELETE FROM EXEC_DOC_REF_TABLE;
        DELETE FROM AMD_VALDN_REF_TABLE;
    END LOOP;

    ---------------------------------------------------------------------------
    -- Update group-level executed-document references
    ---------------------------------------------------------------------------
    MERGE INTO NEGO_TB_ROW_EXEC_DOC_FOR_GRP target_grp_doc
    USING
    (
        SELECT ref.row_id AS ref_row_id,
               amd.amd_id AS new_amd_id
        FROM EXEC_DOC_GRP_REF_TABLE ref
        JOIN LDM_TB_AMD amd
          ON amd.ROWID = ref.rowid_amd
    ) source_data
    ON
    (
        target_grp_doc.row_id = source_data.ref_row_id
        AND target_grp_doc.grp_id = grpId
    )
    WHEN MATCHED THEN
        UPDATE SET
            target_grp_doc.amd_id =
                source_data.new_amd_id,

            target_grp_doc.user_modif =
                Cuser,

            target_grp_doc.date_modif =
                SYSDATE;

    ---------------------------------------------------------------------------
    -- Clear all working tables
    ---------------------------------------------------------------------------
    DELETE FROM AMD_REF_TABLE;
    DELETE FROM EXEC_DOC_REF_TABLE;
    DELETE FROM AMD_VALDN_REF_TABLE;
    DELETE FROM EXEC_DOC_GRP_REF_TABLE;

    COMMIT;

EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK;

        BEGIN
            DELETE FROM AMD_REF_TABLE;
            DELETE FROM EXEC_DOC_REF_TABLE;
            DELETE FROM AMD_VALDN_REF_TABLE;
            DELETE FROM EXEC_DOC_GRP_REF_TABLE;
        EXCEPTION
            WHEN OTHERS THEN
                NULL;
        END;

        RAISE;
END SORT_AMENDMENTS_GROUP;
/