CREATE OR REPLACE PROCEDURE SORT_AMENDMENTS_GROUP
(
    grpId NUMBER,
    Cuser VARCHAR2
)
AS
    ---------------------------------------------------------------------------
    -- Active amendment row -> final AMD_ID mapping
    ---------------------------------------------------------------------------
    TYPE Rec_Amd_Map IS RECORD
    (
        Rowid_Amd  UROWID,
        Old_Amd_Id NUMBER,
        New_Amd_Id NUMBER
    );

    TYPE Typ_Amd_Map IS TABLE OF Rec_Amd_Map
        INDEX BY PLS_INTEGER;

    V_Amd_Map Typ_Amd_Map;

    ---------------------------------------------------------------------------
    -- General variables
    ---------------------------------------------------------------------------
    v_map_index                PLS_INTEGER;
    v_temp_base                NUMBER;

    v_validation_temp_base     NUMBER;
    v_validation_index         PLS_INTEGER;

    v_before_row_count         NUMBER := 0;
    v_after_row_count          NUMBER := 0;

    v_duplicate_before         NUMBER := 0;
    v_duplicate_after          NUMBER := 0;
    v_current_ma_duplicates    NUMBER := 0;

    v_exec_orphan_before       NUMBER := 0;
    v_exec_orphan_after        NUMBER := 0;

    v_validation_orphan_before NUMBER := 0;
    v_validation_orphan_after  NUMBER := 0;

BEGIN
    SAVEPOINT before_sort_amendments_group;

    ---------------------------------------------------------------------------
    -- Clear working tables
    ---------------------------------------------------------------------------
    DELETE FROM AMD_REF_TABLE;
    DELETE FROM EXEC_DOC_REF_TABLE;
    DELETE FROM AMD_VALDN_REF_TABLE;
    DELETE FROM EXEC_DOC_GRP_REF_TABLE;

    ---------------------------------------------------------------------------
    -- Record physical amendment-row count before processing
    ---------------------------------------------------------------------------
    SELECT COUNT(*)
    INTO v_before_row_count
    FROM LDM_TB_AMD amd
    JOIN LDM_TB_MA ma
      ON ma.ma_id = amd.ma_id
    WHERE ma.grp_id = grpId;

    ---------------------------------------------------------------------------
    -- Record duplicate count before processing
    --
    -- The final check confirms that the procedure has not introduced any
    -- additional duplicate (MA_ID, AMD_ID) combinations.
    ---------------------------------------------------------------------------
    SELECT COUNT(*)
    INTO v_duplicate_before
    FROM
    (
        SELECT amd.ma_id,
               amd.amd_id
        FROM LDM_TB_AMD amd
        JOIN LDM_TB_MA ma
          ON ma.ma_id = amd.ma_id
        WHERE ma.grp_id = grpId
          AND amd.amd_id > 0
        GROUP BY amd.ma_id,
                 amd.amd_id
        HAVING COUNT(*) > 1
    );

    ---------------------------------------------------------------------------
    -- Record existing executed-document orphan count
    --
    -- Only non-terminated MAs are considered because only these MAs are
    -- processed by the procedure.
    ---------------------------------------------------------------------------
    SELECT COUNT(*)
    INTO v_exec_orphan_before
    FROM NEGO_TB_ROW_EXEC_DOC doc
    JOIN LDM_TB_MA ma
      ON ma.ma_id = doc.ma_id
    WHERE ma.grp_id = grpId
      AND ma.in_nego_flg = 'N'
      AND NVL(ma.status_id, -1) <> 8
      AND doc.amd_id > 0
      AND NOT EXISTS
      (
          SELECT 1
          FROM LDM_TB_AMD amd
          WHERE amd.ma_id = doc.ma_id
            AND amd.amd_id = doc.amd_id
      );

    ---------------------------------------------------------------------------
    -- Record existing amendment-validation orphan count
    ---------------------------------------------------------------------------
    SELECT COUNT(*)
    INTO v_validation_orphan_before
    FROM AMENDMENT_VALIDATIONS valdn
    JOIN LDM_TB_MA ma
      ON ma.ma_id = valdn.agreement_id
    WHERE ma.grp_id = grpId
      AND ma.in_nego_flg = 'N'
      AND NVL(ma.status_id, -1) <> 8
      AND valdn.amendment_id > 0
      AND NOT EXISTS
      (
          SELECT 1
          FROM LDM_TB_AMD amd
          WHERE amd.ma_id = valdn.agreement_id
            AND amd.amd_id = valdn.amendment_id
      );

    ---------------------------------------------------------------------------
    -- Preserve group executed-document references before changing AMD_ID
    --
    -- If existing duplicate AMD_ID data causes several amendment rows to match
    -- one document row, retain one deterministic physical amendment row.
    --
    -- Preference:
    --   1. Signed, non-terminated amendment
    --   2. Signed, terminated amendment
    --   3. Unsigned amendment
    ---------------------------------------------------------------------------
    INSERT INTO EXEC_DOC_GRP_REF_TABLE
    (
        ROW_ID,
        EXEC_DATE,
        ROWID_AMD
    )
    SELECT row_id,
           exec_date,
           rowid_amd
    FROM
    (
        SELECT negoGrp.row_id AS row_id,
               amd.amd_d_sign AS exec_date,
               amd.ROWID AS rowid_amd,

               ROW_NUMBER() OVER
               (
                   PARTITION BY negoGrp.row_id
                   ORDER BY
                       CASE
                           WHEN amd.amd_d_sign IS NOT NULL
                            AND amd.amd_d_term IS NULL
                           THEN 1

                           WHEN amd.amd_d_sign IS NOT NULL
                           THEN 2

                           ELSE 3
                       END,
                       NVL(amd.term_id, -1),
                       amd.date_creat,
                       amd.ROWID
               ) AS rn

        FROM NEGO_TB_ROW_EXEC_DOC_FOR_GRP negoGrp
        JOIN LDM_TB_MA ma
          ON ma.grp_id = negoGrp.grp_id
        JOIN LDM_TB_AMD amd
          ON amd.ma_id = ma.ma_id
         AND amd.amd_id = negoGrp.amd_id

        WHERE negoGrp.grp_id = grpId

          -- Terminated MAs are excluded from sorting.
          AND NVL(ma.status_id, -1) <> 8

          AND amd.amd_id > 0
    )
    WHERE rn = 1;

    ---------------------------------------------------------------------------
    -- Process each non-terminated, non-negotiation MA
    ---------------------------------------------------------------------------
    FOR Eachma IN
    (
        SELECT ma_id
        FROM LDM_TB_MA
        WHERE grp_id = grpId
          AND in_nego_flg = 'N'
          AND NVL(status_id, -1) <> 8
        ORDER BY ma_id
    )
    LOOP
        -----------------------------------------------------------------------
        -- Clear per-MA reference data
        -----------------------------------------------------------------------
        DELETE FROM EXEC_DOC_REF_TABLE;
        DELETE FROM AMD_VALDN_REF_TABLE;

        -----------------------------------------------------------------------
        -- Preserve all individual executed-document references
        --
        -- Do not exclude terminated amendment rows because every positive row
        -- can be renumbered by this procedure.
        -----------------------------------------------------------------------
        INSERT INTO EXEC_DOC_REF_TABLE
        (
            ROW_ID,
            EXEC_DATE,
            ROWID_AMD
        )
        SELECT row_id,
               exec_date,
               rowid_amd
        FROM
        (
            SELECT nego.row_id AS row_id,
                   amd.amd_d_sign AS exec_date,
                   amd.ROWID AS rowid_amd,

                   ROW_NUMBER() OVER
                   (
                       PARTITION BY nego.row_id
                       ORDER BY
                           CASE
                               WHEN amd.amd_d_sign IS NOT NULL
                                AND amd.amd_d_term IS NULL
                               THEN 1

                               WHEN amd.amd_d_sign IS NOT NULL
                               THEN 2

                               ELSE 3
                           END,
                           NVL(amd.term_id, -1),
                           amd.date_creat,
                           amd.ROWID
                   ) AS rn

            FROM NEGO_TB_ROW_EXEC_DOC nego
            JOIN LDM_TB_AMD amd
              ON amd.ma_id = nego.ma_id
             AND amd.amd_id = nego.amd_id

            WHERE nego.ma_id = Eachma.ma_id
              AND amd.amd_id > 0
        )
        WHERE rn = 1;

        -----------------------------------------------------------------------
        -- Preserve all amendment-validation references
        --
        -- VALIDATOR IS NOT NULL is intentionally not used. Every validation
        -- row linked to an amendment being renumbered must be retained.
        -----------------------------------------------------------------------
        INSERT INTO AMD_VALDN_REF_TABLE
        (
            AMD_ID,
            ROWID_VALDN,
            ROWID_AMD
        )
        SELECT old_amd_id,
               rowid_valdn,
               rowid_amd
        FROM
        (
            SELECT valdn.amendment_id AS old_amd_id,
                   valdn.ROWID AS rowid_valdn,
                   amd.ROWID AS rowid_amd,

                   ROW_NUMBER() OVER
                   (
                       PARTITION BY valdn.ROWID
                       ORDER BY
                           CASE
                               WHEN amd.amd_d_sign IS NOT NULL
                                AND amd.amd_d_term IS NULL
                               THEN 1

                               WHEN amd.amd_d_sign IS NOT NULL
                               THEN 2

                               ELSE 3
                           END,
                           NVL(amd.term_id, -1),
                           amd.date_creat,
                           amd.ROWID
                   ) AS rn

            FROM AMENDMENT_VALIDATIONS valdn
            JOIN LDM_TB_AMD amd
              ON amd.ma_id = valdn.agreement_id
             AND amd.amd_id = valdn.amendment_id

            WHERE valdn.agreement_id = Eachma.ma_id
              AND amd.amd_id > 0
        )
        WHERE rn = 1;

        -----------------------------------------------------------------------
        -- Build chronological mapping for active signed amendment rows
        -----------------------------------------------------------------------
        V_Amd_Map.DELETE;
        v_map_index := 0;

        FOR Maprow IN
        (
            SELECT amd.ROWID AS rowid_amd,
                   amd.amd_id AS old_amd_id,

                   ROW_NUMBER() OVER
                   (
                       ORDER BY amd.amd_d_sign,
                                NVL(amd.term_id, -1),
                                amd.date_creat,
                                amd.ROWID
                   ) AS new_amd_id

            FROM LDM_TB_AMD amd

            WHERE amd.ma_id = Eachma.ma_id
              AND amd.amd_id > 0
              AND amd.amd_d_sign IS NOT NULL
              AND amd.amd_d_term IS NULL

            ORDER BY amd.amd_d_sign,
                     NVL(amd.term_id, -1),
                     amd.date_creat,
                     amd.ROWID
        )
        LOOP
            v_map_index := v_map_index + 1;

            V_Amd_Map(v_map_index).Rowid_Amd :=
                Maprow.rowid_amd;

            V_Amd_Map(v_map_index).Old_Amd_Id :=
                Maprow.old_amd_id;

            V_Amd_Map(v_map_index).New_Amd_Id :=
                Maprow.new_amd_id;
        END LOOP;

        -----------------------------------------------------------------------
        -- Duplicate-safe two-range renumbering
        -----------------------------------------------------------------------
        IF V_Amd_Map.COUNT > 0 THEN
            DECLARE
                v_amd_count          PLS_INTEGER := V_Amd_Map.COUNT;
                v_non_proc_count     NUMBER := 0;
                v_counter            PLS_INTEGER := 0;
                v_non_proc_temp_base NUMBER := 0;
            BEGIN
                ----------------------------------------------------------------
                -- Select a temporary range above every current AMD_ID
                ----------------------------------------------------------------
                SELECT NVL(MAX(ABS(amd_id)), 0) + 10000
                INTO v_temp_base
                FROM LDM_TB_AMD
                WHERE ma_id = Eachma.ma_id;

                ----------------------------------------------------------------
                -- A second independent temporary range is used for rows that
                -- are not part of the active chronological mapping.
                ----------------------------------------------------------------
                v_non_proc_temp_base :=
                    v_temp_base
                    + v_amd_count
                    + 10000;

                ----------------------------------------------------------------
                -- Phase 1:
                -- Move all active signed amendment rows to temporary IDs.
                ----------------------------------------------------------------
                FOR i IN V_Amd_Map.FIRST .. V_Amd_Map.LAST
                LOOP
                    UPDATE LDM_TB_AMD
                    SET amd_id     = v_temp_base + i,
                        date_modif = SYSDATE,
                        user_modif = Cuser
                    WHERE ROWID = V_Amd_Map(i).Rowid_Amd;

                    IF SQL%ROWCOUNT <> 1 THEN
                        RAISE_APPLICATION_ERROR
                        (
                            -20030,
                            'Unable to temporarily move active amendment for MA '
                            || Eachma.ma_id
                        );
                    END IF;
                END LOOP;

                ----------------------------------------------------------------
                -- Count all positive rows not moved into the active range.
                --
                -- These normally include:
                --   * signed terminated amendment rows;
                --   * unsigned amendment rows.
                ----------------------------------------------------------------
                SELECT COUNT(*)
                INTO v_non_proc_count
                FROM LDM_TB_AMD amd
                WHERE amd.ma_id = Eachma.ma_id
                  AND amd.amd_id > 0
                  AND amd.amd_id NOT BETWEEN
                      v_temp_base + 1
                      AND v_temp_base + v_amd_count;

                ----------------------------------------------------------------
                -- Phase 2:
                -- Move all excluded positive rows to their own safe range.
                ----------------------------------------------------------------
                IF v_non_proc_count > 0 THEN
                    v_counter := 0;

                    FOR NonProcessedRow IN
                    (
                        SELECT amd.ROWID AS rowid_amd
                        FROM LDM_TB_AMD amd
                        WHERE amd.ma_id = Eachma.ma_id
                          AND amd.amd_id > 0
                          AND amd.amd_id NOT BETWEEN
                              v_temp_base + 1
                              AND v_temp_base + v_amd_count

                        ORDER BY
                            CASE
                                WHEN amd.amd_d_term IS NOT NULL
                                THEN 1

                                WHEN amd.amd_d_sign IS NULL
                                THEN 2

                                ELSE 3
                            END,
                            amd.amd_id,
                            NVL(amd.term_id, -1),
                            amd.date_creat,
                            amd.ROWID
                    )
                    LOOP
                        v_counter := v_counter + 1;

                        UPDATE LDM_TB_AMD
                        SET amd_id =
                                v_non_proc_temp_base
                                + v_counter,
                            date_modif = SYSDATE,
                            user_modif = Cuser
                        WHERE ROWID =
                              NonProcessedRow.rowid_amd;

                        IF SQL%ROWCOUNT <> 1 THEN
                            RAISE_APPLICATION_ERROR
                            (
                                -20031,
                                'Unable to temporarily move excluded amendment for MA '
                                || Eachma.ma_id
                            );
                        END IF;
                    END LOOP;
                END IF;

                ----------------------------------------------------------------
                -- Phase 3:
                -- Assign final chronological IDs 1..N to active rows.
                ----------------------------------------------------------------
                FOR i IN V_Amd_Map.FIRST .. V_Amd_Map.LAST
                LOOP
                    UPDATE LDM_TB_AMD
                    SET amd_id     = V_Amd_Map(i).New_Amd_Id,
                        date_modif = SYSDATE,
                        user_modif = Cuser
                    WHERE ROWID = V_Amd_Map(i).Rowid_Amd;

                    IF SQL%ROWCOUNT <> 1 THEN
                        RAISE_APPLICATION_ERROR
                        (
                            -20032,
                            'Unable to assign final active AMD_ID for MA '
                            || Eachma.ma_id
                        );
                    END IF;
                END LOOP;

                ----------------------------------------------------------------
                -- Phase 4:
                -- Assign excluded rows unique IDs after the active sequence.
                ----------------------------------------------------------------
                v_counter := 0;

                FOR NonProcessedRow IN
                (
                    SELECT amd.ROWID AS rowid_amd
                    FROM LDM_TB_AMD amd
                    WHERE amd.ma_id = Eachma.ma_id
                      AND amd.amd_id > v_non_proc_temp_base
                    ORDER BY amd.amd_id,
                             amd.ROWID
                )
                LOOP
                    v_counter := v_counter + 1;

                    UPDATE LDM_TB_AMD
                    SET amd_id =
                            v_amd_count
                            + v_counter,
                        date_modif = SYSDATE,
                        user_modif = Cuser
                    WHERE ROWID =
                          NonProcessedRow.rowid_amd;

                    IF SQL%ROWCOUNT <> 1 THEN
                        RAISE_APPLICATION_ERROR
                        (
                            -20033,
                            'Unable to assign final excluded AMD_ID for MA '
                            || Eachma.ma_id
                        );
                    END IF;
                END LOOP;
            END;
        END IF;

        -----------------------------------------------------------------------
        -- Update individual executed-document references by amendment ROWID
        -----------------------------------------------------------------------
        MERGE INTO NEGO_TB_ROW_EXEC_DOC exec_doc
        USING
        (
            SELECT reft.row_id AS ref_row_id,
                   amd.amd_id AS new_amd_id
            FROM EXEC_DOC_REF_TABLE reft
            JOIN LDM_TB_AMD amd
              ON amd.ROWID = reft.rowid_amd
            WHERE amd.ma_id = Eachma.ma_id
        ) data_t
        ON
        (
            exec_doc.row_id = data_t.ref_row_id
            AND exec_doc.ma_id = Eachma.ma_id
        )
        WHEN MATCHED THEN
            UPDATE SET
                exec_doc.amd_id     = data_t.new_amd_id,
                exec_doc.user_modif = Cuser,
                exec_doc.date_modif = SYSDATE;

        -----------------------------------------------------------------------
        -- Temporarily move all captured validation IDs
        -----------------------------------------------------------------------
        SELECT NVL(MAX(ABS(amendment_id)), 0) + 10000
        INTO v_validation_temp_base
        FROM AMENDMENT_VALIDATIONS
        WHERE agreement_id = Eachma.ma_id;

        v_validation_index := 0;

        FOR ValidationRef IN
        (
            SELECT rowid_valdn,
                   rowid_amd
            FROM AMD_VALDN_REF_TABLE
            ORDER BY rowid_valdn
        )
        LOOP
            v_validation_index :=
                v_validation_index + 1;

            UPDATE AMENDMENT_VALIDATIONS
            SET amendment_id =
                    v_validation_temp_base
                    + v_validation_index
            WHERE ROWID =
                  ValidationRef.rowid_valdn;
        END LOOP;

        -----------------------------------------------------------------------
        -- Assign final validation IDs from the referenced amendment ROWID
        -----------------------------------------------------------------------
        FOR ValidationRef IN
        (
            SELECT ref.rowid_valdn,
                   amd.amd_id AS final_amd_id
            FROM AMD_VALDN_REF_TABLE ref
            JOIN LDM_TB_AMD amd
              ON amd.ROWID = ref.rowid_amd
            ORDER BY ref.rowid_valdn
        )
        LOOP
            UPDATE AMENDMENT_VALIDATIONS
            SET amendment_id =
                    ValidationRef.final_amd_id
            WHERE ROWID =
                  ValidationRef.rowid_valdn;
        END LOOP;

        -----------------------------------------------------------------------
        -- Every processed MA must have unique positive AMD_ID values
        -----------------------------------------------------------------------
        SELECT COUNT(*)
        INTO v_current_ma_duplicates
        FROM
        (
            SELECT amd_id
            FROM LDM_TB_AMD
            WHERE ma_id = Eachma.ma_id
              AND amd_id > 0
            GROUP BY amd_id
            HAVING COUNT(*) > 1
        );

        IF v_current_ma_duplicates > 0 THEN
            RAISE_APPLICATION_ERROR
            (
                -20034,
                'Duplicate AMD_ID generated for MA '
                || Eachma.ma_id
            );
        END IF;

        -----------------------------------------------------------------------
        -- Clear current MA working data
        -----------------------------------------------------------------------
        DELETE FROM EXEC_DOC_REF_TABLE;
        DELETE FROM AMD_VALDN_REF_TABLE;

        V_Amd_Map.DELETE;
    END LOOP;

    ---------------------------------------------------------------------------
    -- Update group executed-document references using preserved amendment ROWID
    ---------------------------------------------------------------------------
    MERGE INTO NEGO_TB_ROW_EXEC_DOC_FOR_GRP exec_doc_grp
    USING
    (
        SELECT ref_row_id,
               new_amd_id
        FROM
        (
            SELECT reft.row_id AS ref_row_id,
                   amd.amd_id AS new_amd_id,

                   ROW_NUMBER() OVER
                   (
                       PARTITION BY reft.row_id
                       ORDER BY
                           CASE
                               WHEN amd.amd_d_sign IS NOT NULL
                                AND amd.amd_d_term IS NULL
                               THEN 1

                               WHEN amd.amd_d_sign IS NOT NULL
                               THEN 2

                               ELSE 3
                           END,
                           amd.amd_id,
                           amd.ROWID
                   ) AS rn

            FROM EXEC_DOC_GRP_REF_TABLE reft
            JOIN LDM_TB_AMD amd
              ON amd.ROWID = reft.rowid_amd
        )
        WHERE rn = 1
    ) data_t
    ON
    (
        exec_doc_grp.row_id = data_t.ref_row_id
        AND exec_doc_grp.grp_id = grpId
    )
    WHEN MATCHED THEN
        UPDATE SET
            exec_doc_grp.amd_id     = data_t.new_amd_id,
            exec_doc_grp.user_modif = Cuser,
            exec_doc_grp.date_modif = SYSDATE;

    ---------------------------------------------------------------------------
    -- Confirm that no additional duplicate combinations were created
    ---------------------------------------------------------------------------
    SELECT COUNT(*)
    INTO v_duplicate_after
    FROM
    (
        SELECT amd.ma_id,
               amd.amd_id
        FROM LDM_TB_AMD amd
        JOIN LDM_TB_MA ma
          ON ma.ma_id = amd.ma_id
        WHERE ma.grp_id = grpId
          AND amd.amd_id > 0
        GROUP BY amd.ma_id,
                 amd.amd_id
        HAVING COUNT(*) > 1
    );

    IF v_duplicate_after > v_duplicate_before THEN
        RAISE_APPLICATION_ERROR
        (
            -20035,
            'The procedure created additional duplicate AMD_ID values for group '
            || grpId
            || '. Before='
            || v_duplicate_before
            || ', After='
            || v_duplicate_after
        );
    END IF;

    ---------------------------------------------------------------------------
    -- Confirm that no new executed-document orphan references were created
    ---------------------------------------------------------------------------
    SELECT COUNT(*)
    INTO v_exec_orphan_after
    FROM NEGO_TB_ROW_EXEC_DOC doc
    JOIN LDM_TB_MA ma
      ON ma.ma_id = doc.ma_id
    WHERE ma.grp_id = grpId
      AND ma.in_nego_flg = 'N'
      AND NVL(ma.status_id, -1) <> 8
      AND doc.amd_id > 0
      AND NOT EXISTS
      (
          SELECT 1
          FROM LDM_TB_AMD amd
          WHERE amd.ma_id = doc.ma_id
            AND amd.amd_id = doc.amd_id
      );

    IF v_exec_orphan_after > v_exec_orphan_before THEN
        RAISE_APPLICATION_ERROR
        (
            -20036,
            'The procedure created additional invalid executed-document '
            || 'references for group '
            || grpId
            || '. Before='
            || v_exec_orphan_before
            || ', After='
            || v_exec_orphan_after
        );
    END IF;

    ---------------------------------------------------------------------------
    -- Confirm that no new validation orphan references were created
    ---------------------------------------------------------------------------
    SELECT COUNT(*)
    INTO v_validation_orphan_after
    FROM AMENDMENT_VALIDATIONS valdn
    JOIN LDM_TB_MA ma
      ON ma.ma_id = valdn.agreement_id
    WHERE ma.grp_id = grpId
      AND ma.in_nego_flg = 'N'
      AND NVL(ma.status_id, -1) <> 8
      AND valdn.amendment_id > 0
      AND NOT EXISTS
      (
          SELECT 1
          FROM LDM_TB_AMD amd
          WHERE amd.ma_id = valdn.agreement_id
            AND amd.amd_id = valdn.amendment_id
      );

    IF v_validation_orphan_after > v_validation_orphan_before THEN
        RAISE_APPLICATION_ERROR
        (
            -20037,
            'The procedure created additional invalid amendment-validation '
            || 'references for group '
            || grpId
            || '. Before='
            || v_validation_orphan_before
            || ', After='
            || v_validation_orphan_after
        );
    END IF;

    ---------------------------------------------------------------------------
    -- Confirm that no physical amendment row was added or deleted
    ---------------------------------------------------------------------------
    SELECT COUNT(*)
    INTO v_after_row_count
    FROM LDM_TB_AMD amd
    JOIN LDM_TB_MA ma
      ON ma.ma_id = amd.ma_id
    WHERE ma.grp_id = grpId;

    IF v_before_row_count <> v_after_row_count THEN
        RAISE_APPLICATION_ERROR
        (
            -20038,
            'LDM_TB_AMD row count changed for group '
            || grpId
            || '. Before='
            || v_before_row_count
            || ', After='
            || v_after_row_count
        );
    END IF;

    ---------------------------------------------------------------------------
    -- Cleanup
    ---------------------------------------------------------------------------
    DELETE FROM AMD_REF_TABLE;
    DELETE FROM EXEC_DOC_REF_TABLE;
    DELETE FROM AMD_VALDN_REF_TABLE;
    DELETE FROM EXEC_DOC_GRP_REF_TABLE;

    COMMIT;

EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK TO before_sort_amendments_group;

        BEGIN
            DELETE FROM AMD_REF_TABLE;
            DELETE FROM EXEC_DOC_REF_TABLE;
            DELETE FROM AMD_VALDN_REF_TABLE;
            DELETE FROM EXEC_DOC_GRP_REF_TABLE;
        EXCEPTION
            WHEN OTHERS THEN
                NULL;
        END;

        RAISE;

END SORT_AMENDMENTS_GROUP;
/