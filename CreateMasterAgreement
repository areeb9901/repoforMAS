private boolean isPrefillingEnabledForMa(){

StringBuilder agreementTypeKey = new StringBuilder();

Boolean isPreview = (currentStep == PreviewAndSave.INSTANCE && PreviewAndSave.INSTANCE.validate(this));

agreementTypeKey.append(getAgreementType().getId().getId()).append(getAgreementType().getId().getMonth()).append(getAgreementType().getId().getYear());

switch(agreementTypeKey.toString().toUpperCase()){

case "FBFD62013" : if(isPreview)

return isFbfEligibleForPrefillingPreviewAndSave();

else

return isFbfEligibleForPrefilling();

case "RAHMENVERT92018" : return isRahmenvertEligibleForPrefilling();

default: return false;

}

}

private  void setAcknowledgmentComment(MasterAgreement ma) {

String cpId = ma.getCounterpartyEntity().getId().toString();

if (ackCommentToBeShown && acknowledge && BeagleStringUtils.isNotEmpty(ackComment)) {

ma.setOverlappedProdComm(ackComment);

ma.setAcknowledgement(acknowledge);

if (overlapParameters.getOverlapAgreementsMap() != null) {

Long key = Long.valueOf(cpId);

List<Long> overlappedIds = overlapParameters.getOverlapAgreementsMap().get(key);

if (CollectionUtils.isNotEmpty(overlappedIds)) {

overlapParameters.getOverlapAgreementsMap().put(ma.getId(), overlappedIds);

overlapParameters.getOverlapAgreementsMap().remove(key);

}

}

OverlapHelper.saveOrUpdateOverlapHistory(overlapParameters, repository, getUser());

}

