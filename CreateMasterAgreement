public String step(WizardStep currentStep) {

if (currentStep != null) {

if (isPrevious(currentStep)) {

return backtrackOneStep();

}

if (currentStep.getPrevious() == CreateOrCopyMa.INSTANCE) {

boolean validationStatus = CreateOrCopyMa.INSTANCE.validate(this);

if (!validationStatus) {

return INPUT;

}

}

}

if (currentStep == PreviewAndSave.INSTANCE && PreviewAndSave.INSTANCE.validate(this)) {

return createPreviewAgreement();

}

setMaDefaults();

return INPUT;

}

private boolean isPrevious(WizardStep currentStep) {

return currentStep.getPrevious() != null && !currentStep.getPrevious().validate(this);

}

