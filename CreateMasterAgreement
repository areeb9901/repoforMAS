protected InputField multipleSelect(String field) {

List<Long> clearingHouseList = repository.getFcmClearingHouseList();

List<Entity> entities = repository.findObjects(Entity.class, clearingHouseList);

Set<Option> options = getOptions(entities);

if(field.equalsIgnoreCase("clearingHousesForCAA")){

TreeSet<Option> tree_set = new TreeSet<>(options);

options=tree_set;

}

List<Long> newClearingHouseList = clearingHouses;

if (newClearingHouseList != null && !newClearingHouseList.isEmpty()) {

for (Option option : options) {

if (newClearingHouseList != null && !newClearingHouseList.isEmpty()) {

for (Option option : options) {

for (Long item : newClearingHouseList) {

if (!StringUtils.isEmpty(option.getValue()) && item.equals(Long.valueOf(option.getValue()))) {

option.setSelected(true);

} else if (StringUtils.isEmpty(option.getValue())) {

option.setSelected(false);

}

}

}

}

return factory.select(field, options).multiple();

}

private static Set getOptions(List<Entity> entities) {

Set<Option> result = new LinkedHashSet<Option>();

result.add(new Option("", "", "", "- Not Set -"));

for (Entity entity : entities) {

String text = entity.getLegalName() != null ? entity.getLegalName() : entity.getNonLegalName();

String value = entity.getId().toString();

String id = entity.getId().toString();

Option option = new Option(id, text, value, text);

result.add(option);

}

return result;

}

