return DOCUMENT_ASSEMBLER_EMAD;}else if (draft(MA_TYPE_DERIVATIVE, "draftISDAFrenchLaw", draftType())) {

return DOCUMENT_ASSEMBLER_FOR_ISDAFRENCH_LAW;

}

return SUCCESS;

} catch (InvalidMasterAgreementException e) {

addErrorsFromException(e);

return INPUT;

}

